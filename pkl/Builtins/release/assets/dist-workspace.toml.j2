# cargo-dist workspace configuration. Unix-first (macOS and Linux), a `curl | sh`
# shell installer, releases on plain `v<semver>` tags. The release workflow is
# generated by `dist generate` and must not be edited by hand. cargo-dist is
# pinned in mise.toml. Windows is deferred (add "x86_64-pc-windows-msvc" to
# `targets` later).

[workspace]
members = ["cargo:."]

# Config for 'dist'
[dist]
cargo-dist-version = "{{ dist }}"
installers = ["shell"]
targets = [{% for t in targets %}"{{ t }}"{% if not loop.last %}, {% endif %}{% endfor %}]
ci = "github"
install-path = "CARGO_HOME"
install-updater = false
# Releases only happen on a version tag push, so a PR dry run adds noise
# without value (it also holds PRs at mergeStateStatus=UNSTABLE).
pr-run-mode = "skip"

# cargo-dist's default `ubuntu-20.04` runner was retired by GitHub, so release
# jobs queued forever. Pin the global jobs and the Linux targets.
[dist.github-custom-runners]
global = "{{ linuxRunner }}"
aarch64-unknown-linux-gnu = "{{ linuxRunner }}"
x86_64-unknown-linux-gnu = "{{ linuxRunner }}"
aarch64-apple-darwin = "{{ macosRunner }}"
x86_64-apple-darwin = "{{ macosRunner }}"

[dist.github-action-commits]
"actions/checkout" = "{{ checkoutSha }}"       # v7
"actions/upload-artifact" = "{{ uploadArtifactSha }}" # v7
"actions/download-artifact" = "{{ downloadArtifactSha }}" # v8
