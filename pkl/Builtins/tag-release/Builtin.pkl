/// The tag-release builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.TagRelease

import "../../Config.pkl"
import "../Shared.pkl"

/// The files of this builtin that `parameterisedFiles()` renders.
function parameterisedFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  when (opts.binary) {
    [".github/scripts/tag-release.sh"] = new Config.GenFile {
      content = read("assets/tag-release.sh.tmpl").text.replaceAll("@@CRATE@@", Shared.needCrateName(opts))
      executable = true
    }
  }
}
