# actionlint configuration, read automatically from this path.
#
# .github/workflows/{{ releaseWorkflow }} is generated by cargo-dist and overwritten on
# `dist generate`, so shell style findings in its scripts cannot be fixed by
# editing it. These two shellcheck rules are ignored for that one file only;
# every other rule, and every other file, is still checked.
paths:
  .github/workflows/{{ releaseWorkflow }}:
    ignore:
{% for i in ignores %}
      # {{ i.code }}: {{ i.reason }}
      - 'shellcheck reported issue in this script: {{ i.code }}:.+'
{% endfor %}
