/// Entry module of the pantheon-scaffold package. A repository amends this module in its
/// scaffold.pkl, sets `options`, `workflows` and `files`, and the runner reads the one JSON
/// document this module renders (decision 44, contract.schema.json).
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Config

import "pkl:reflect"
import "Pins.pkl"
import "GenFiles.pkl"
import "Workflows.pkl"

/// Version of the JSON document. The runner rejects any other value.
const schemaVersion: Int = 2

/// The oldest runner that can render this package. Raise it by hand in the release that needs a newer runner.
const requiresRunner: String = "0.0.0"

class Options {
  /// The Rust toolchain, one source for every file that names it.
  toolchain: String
  /// The runner version pinned in mise.toml. Left unset it is read from the version of the package that rendered the file, because the
  /// runner and the package are released together. A package loaded from a folder has no version, so set this to use the mise builtin there.
  runnerVersion: String?
  /// `all` builds, lints and tests with `--all-features`, as the library repository does. Read by the hook steps and by rust-ci.yml.
  features: ("default"|"all") = "default"
  /// The client id of the GitHub App the pr-auto-rebase and release-automerge workflows mint their token from (a public identifier, not a
  /// secret). The default is the org's pantheon-ai-bot App, as the four repositories use it today.
  appClientId: String = "Iv23ligzn16vkDCWfHgc"
  /// Whether the repository builds a binary released with cargo-dist (the `binary` toggle). Needs `crateName`. Owns dist-workspace.toml,
  /// .github/actionlint.yaml, .github/scripts/tag-release.sh, .github/zizmor.yml and the external release.yml. Without a binary there is no
  /// generated release.yml, so release-please does not tag the crate itself and zizmor has no config file to read.
  binary: Boolean = true
  /// Whether the repository carries a skill (the `skills` toggle). Needs `skillName`. Owns audit-skill.yml, the skill lines of .coderabbit.yaml
  /// and SECURITY.md, and the wording of the agnix files.
  skills: Boolean = true
  /// Whether the repository has its own composite action, action.yml, which zizmor then scans too (the `compositeAction` toggle).
  compositeAction: Boolean = false
  /// The crate whose Cargo.toml release-please bumps. Named by the header of release-please.yml, tag-release.sh and SECURITY.md. Needed when `binary` is on.
  crateName: String?
  /// The skill folder name under `skills/`, for the files that refer to it (audit-skill.yml, .coderabbit.yaml, SECURITY.md). Needed when `skills` is on.
  skillName: String?
  /// Git dependencies pinned by tag that Dependabot cannot resolve, so it must ignore them.
  gitDependencyIgnore: Listing<String> = new {}
  /// Builtins to leave out, by name: the folder names under `pkl/Builtins/` (`rumdl`, `pull-request-template`, `mise` and the rest). Empty by default,
  /// so every builtin is present. The aggregators in Builtins.pkl skip a left-out builtin, and a builtin that cannot work without another fails with
  /// an error that names both. A name that is not a builtin, or one listed twice, is an error. Only the aggregators read it: calling a single builtin
  /// function (`rustCi(opts)`) still renders it, and not spreading an aggregator is not leaving its builtins out.
  without: Listing<String> = new {}

  /// `skillName`, or an error that says why it is needed. Read by the builtins that name the skill folder.
  function requireSkillName(): String =
    skillName ?? throw("options.skillName is required when options.skills is true: it names the folder under skills/ that audit-skill.yml, .coderabbit.yaml and SECURITY.md refer to. Set skillName, or set skills = false.")

  /// `crateName`, or an error that says why it is needed. Read by the builtins that name the crate.
  function requireCrateName(): String =
    crateName ?? throw("options.crateName is required when options.binary is true: tag-release.sh and SECURITY.md name the crate. Set crateName, or set binary = false.")
}

options: Options

/// The Preset files this configuration applies, by path under presets/. They are recorded in the contract so the runner can list them,
/// and hash them as inputs. A file in presets/ that no configuration lists is reported as unused.
presets: Listing<String> = new {}

/// Workflows by file name without extension. Builtins and custom workflows go here.
workflows: Mapping<String, Workflows.Workflow> = new {}

/// Files that are not workflows, by path.
files: Mapping<String, GenFiles.GenFile> = new {}

/// Every pin used by a step, de-duplicated by action and sha.
local usedPins: List<Pins.Pin> = workflows.toMap().values.flatMap((w) -> w.pins).distinct

/// Escape hatch accounting for gate B: uses over typed constructs (workflows, jobs and steps).
local escapeUses: Int = workflows.toMap().values.map((w) -> w.escapeUses).fold(0, (a, b) -> a + b)

/// Where this module was loaded from. For a released package that is its package:// URI, which carries the version.
local definingUri: String = reflect.Class(Options).enclosingDeclaration.uri

local constructCount: Int = workflows.toMap().values.map((w) -> w.constructs).fold(0, (a, b) -> a + b)

local generated: Map<String, GenFiles.GenFile> =
  workflows.toMap().mapKeys((k, _) -> ".github/workflows/\(k).yml")
    .mapValues((_, w) -> new GenFiles.GenFile { content = w.rendered; removeOnDetach = w.removeOnDetach })
  + files.toMap()

contract: Dynamic = new Dynamic {
  schemaVersion = module.schemaVersion
  files = generated.keys.toList().sort().map((filePath) ->
    let (f = generated[filePath])
      f.entry(filePath)
  ).toListing()
  pins = usedPins.sortWith((a, b) -> a.action < b.action).map((p) -> p.entry).toListing()
  escapeHatch = new Dynamic {
    uses = escapeUses
    constructs = constructCount
  }
  when (definingUri.startsWith("package://")) { packageUri = definingUri }
  when (module.presets.length > 0) { presets = module.presets }
  requires = new Dynamic { runner = requiresRunner }
}

output {
  renderer = new JsonRenderer { omitNullProperties = true }
  value = contract
}
