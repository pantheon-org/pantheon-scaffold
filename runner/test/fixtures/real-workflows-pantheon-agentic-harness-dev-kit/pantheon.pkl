amends "../../../../pkl/Config.pkl"

import "../../../../pkl/Builtins.pkl"

// Phase 4 wave D: every workflow builtin, set up like pantheon-agentic-harness-dev-kit, rendered by scripts/real-repo-workflows.ts and compared with the real repository.
options {
  toolchain = "1.96.1"
  binary = false
  skills = false
  features = "all"
}

workflows {
  ["plumber"] = Builtins.plumber()
  ["sync-labels"] = Builtins.syncLabels()
  ["pr-auto-rebase"] = Builtins.prAutoRebase(options)
  ["release-automerge"] = Builtins.releaseAutomerge(options)
  ["commit-types"] = Builtins.commitTypes()
  ["conventional-commits"] = Builtins.conventionalCommits()
  ["release-please"] = Builtins.releasePlease(options)
  ["zizmor"] = Builtins.zizmor(options)
  ["agnix"] = Builtins.agnix(options)
  ["aislop"] = Builtins.aislop()
  ["rust-ci"] = Builtins.rustCi(options)
  ["cargo-deny"] = Builtins.cargoDeny(options)
  ["inline-scripts"] = Builtins.inlineScripts()
}

files {
  ...Builtins.workflowFiles()
  ...Builtins.analysisFiles(options)
}
