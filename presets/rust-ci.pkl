// The tests of this repository run pkl, so the Rust CI job installs the pinned tools through mise, and they leave out the features crate,
// which drives a built binary and has its own jobs in ci.yml.
import "../pkl/Steps.pkl"
import "../pkl/Workflows.pkl"
import "../pkl/Pins.pkl"
import "../pkl/Presets.pkl"

function apply(workflows: Mapping<String, Workflows.Workflow>): Mapping<String, Workflows.Workflow> =
  Presets.amendWorkflow(workflows, "rust-ci", (w) -> w.amendJob("build-test", (j) ->
    ((j) { env { ["GITHUB_TOKEN"] = "${{ github.token }}"; ["MISE_DISABLE_TOOLS"] = "rust" } })
      .insertStepsBefore(
        "Test",
        List(
          new Steps.Step {
            uses = Pins.miseAction
            `with` = new Mapping { ["version"] = "2026.10.25"; ["install"] = false; ["cache"] = false }
          },
          new Steps.Step { name = "Install the pinned tools from the lock file"; run = "mise install --locked" }
        )
      )
      .amendStep("Test", (s) -> (s) { run = "mise x -- cargo test --workspace --exclude scaffold-features --locked" })))
