/// The claude-settings builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.ClaudeSettings

import "../../Config.pkl"
import "../../Values.pkl"

/// The file of this builtin that `toolingFiles()` renders.
function toolingFiles(): Mapping<String, Config.GenFile> = new {
  [".claude/settings.json"] = new Config.GenFile {
    template = read("assets/claude-settings.json.j2").text
    context = new Mapping {
      ["schemaUrl"] = Values.claudeSettingsSchemaUrl
      ["sessionUrl"] = Values.claudeSessionUrl
    }
  }
}
