/// The gitignore builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Gitignore

import "../../Config.pkl"

/// The verbatim file of this builtin that `verbatimFiles()` renders.
function verbatimFiles(): Mapping<String, Config.GenFile> = new {
  [".gitignore"] = new Config.GenFile { content = read("assets/gitignore").text }
}
