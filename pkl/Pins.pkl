/// Action pins. The version is always a release tag (decision 71), and the runner appends it as a comment.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Pins

class Pin {
  /// owner/repo, with an optional path (for example owner/repo/.github/workflows/x.yml).
  action: String
  /// The 40 hex character commit of the release tag.
  sha: String(matches(Regex("[0-9a-f]{40}")))
  /// The release tag, for example v7.0.1.
  version: String
}

checkout: Pin = new { action = "actions/checkout"; sha = "3d3c42e5aac5ba805825da76410c181273ba90b1"; version = "v7.0.1" }
miseAction: Pin = new { action = "jdx/mise-action"; sha = "b44d12e7d0d8ee7461bb893e1b1993500433185b"; version = "v5.2.7" }
createGithubAppToken: Pin = new { action = "actions/create-github-app-token"; sha = "64ab729a6294000f5aa4a4bc0b73d1f32bc45510"; version = "v3.3.0" }
plumber: Pin = new { action = "getplumber/plumber"; sha = "ec8cb3a7edd6a324b33e85109b627b2df6023d94"; version = "v0.7.23" }
releasePleaseAction: Pin = new { action = "googleapis/release-please-action"; sha = "45996ed1f6d02564a971a2fa1b5860e934307cf7"; version = "v5.0.0" }
zizmorAction: Pin = new { action = "zizmorcore/zizmor-action"; sha = "45d7276c9ca790aabd705e31ca99c6185c3e76dd"; version = "v0.8.1" }
setupNode: Pin = new { action = "actions/setup-node"; sha = "949feb2413d6458794dcd2491c4babbbce0c15c1"; version = "v7.1.0" }
findComment: Pin = new { action = "peter-evans/find-comment"; sha = "b30e6a3c0ed37e7c023ccd3f1db5c6c0b0c23aad"; version = "v4.0.0" }
createOrUpdateComment: Pin = new { action = "peter-evans/create-or-update-comment"; sha = "e8674b075228eee787fea43ef493e45ece1004c9"; version = "v5.0.0" }
