/// The dependabot builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Dependabot

import "../../Config.pkl"
import "../../Pins.pkl"

/// The github-actions entry excludes every workflow file the package renders (`exclude-paths`): the runner owns them, so a Dependabot bump of a
/// pin in one is drift, and `check` exits 4. Their pins move through Pins.pkl and `upgrade`. Workflows the repository writes itself are still updated.
function file(opts: Config.Options, workflowNames: List<String>): Config.GenFile =
  let (names = opts.gitDependencyIgnore.toList().join(" and "))
  new Config.GenFile {
    content =
      commentBlock((
        if (opts.gitDependencyIgnore.isEmpty) #"""
          Keeps Cargo dependencies and the SHA-pinned GitHub Actions current. Minor and
          patch bumps are grouped into one weekly PR per ecosystem to cut review noise;
          major bumps are raised individually so breaking changes are reviewed alone.
          Ported from pantheon-org/tekhne.

          Cargo caveat: the pantheon-agentic-harness-dev-kit crates are git dependencies
          pinned by tag in Cargo.toml. Dependabot does not reliably move a git tag, so
          bump that tag by hand when the dev-kit cuts a release.
          """#
        else #"""
          Keeps Cargo dependencies and the SHA-pinned GitHub Actions current. Minor and
          patch bumps are grouped into one weekly PR per ecosystem to cut review noise;
          major bumps are raised individually so breaking changes are reviewed alone.
          Ported from pantheon-org/tekhne.

          Cargo caveat: pahdk-core and pahdk-install are git dependencies pinned by tag in
          Cargo.toml. Dependabot cannot resolve them (dependency_file_not_resolvable), and
          that error fails the whole cargo job, so they are ignored below. Bump the tag by
          hand when pantheon-agentic-harness-dev-kit cuts a release.
          """#) + (if (opts.binary) distNote else "")
      ) + yamlConfig.renderValue(new Dynamic {
        version = 2
        updates = new Listing {
          new Dynamic {
            `package-ecosystem` = "cargo"
            directory = "/"
            schedule = new Dynamic { interval = "weekly"; day = "monday" }
            `open-pull-requests-limit` = 5
            cooldown = new Dynamic { `default-days` = 7 }
            when (!opts.gitDependencyIgnore.isEmpty) {
              ignore = opts.gitDependencyIgnore.toList().map((n) -> new Dynamic { `dependency-name` = n }).toListing()
            }
            labels = new Listing { "dependencies"; "rust" }
            `commit-message` = new Dynamic { prefix = "chore"; `prefix-development` = "chore"; include = "scope" }
            groups = new Dynamic { `cargo-minor-patch` = dependabotGroup.apply("cargo") }
          }
          new Dynamic {
            `package-ecosystem` = "github-actions"
            directory = "/"
            schedule = new Dynamic { interval = "weekly"; day = "monday" }
            `open-pull-requests-limit` = 5
            cooldown = new Dynamic { `default-days` = 7 }
            `exclude-paths` = workflowNames.map((k) -> ".github/workflows/\(k).yml").toListing()
            when (opts.binary) {
              ignore = new Listing {
                new Dynamic { `dependency-name` = "actions/upload-artifact" }
                new Dynamic { `dependency-name` = "actions/download-artifact" }
              }
            }
            labels = new Listing { "dependencies"; "github-actions" }
            `commit-message` = new Dynamic { prefix = "ci"; include = "scope" }
            groups = new Dynamic { `actions-minor-patch` = dependabotGroup.apply("actions") }
          }
        }
      })
  }

local yamlConfig = new YamlRenderer { omitNullProperties = true }

/// Comment lines for the top of a rendered file, the same as the header of a workflow.
local function commentBlock(text: String): String =
  text.split("\n").map((l) -> if (l == "") "#" else "# \(l)").join("\n") + "\n"

local dependabotGroup = (name: String) -> new Dynamic {
  patterns = new Listing { "*" }
  `update-types` = new Listing { "minor"; "patch" }
}

/// Dependabot's configuration. The git dependencies in `options.gitDependencyIgnore` are ignored, because Dependabot cannot resolve a git
/// dependency pinned by tag and that error fails the whole cargo job. The github-actions ecosystem is not in the consumer file.
/// Added to the header of dependabot.yml for a repository with a binary (decision 86).
local distNote: String = "\n\n" + #"""
  release.yml caveat: release.yml is written by `dist generate` from dist-workspace.toml, which
  Dependabot cannot edit, so a Dependabot bump of upload-artifact or download-artifact inside
  it would fail the dist check. They are ignored below: change their commits in
  dist-workspace.toml and run `dist generate`.
  """#
