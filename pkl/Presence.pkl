/// Which builtins are present. `Present` is a class-as-a-function: the input is `without`, the builtins that `options.without` leaves out, and
/// `checked`, `has`, `presentFlags` and `toolFlags` are the outputs. `Presence.forOptions(opts)` builds one from the options. Use it as
/// `import "Presence.pkl"`.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Presence

import "Config.pkl"

/// The names of the builtins, one for each folder of `pkl/Builtins/`: `options.without` takes these names. A test compares this list with the
/// folder listing, so the two cannot drift. A workflow key can differ from the name (`dist-check` is rendered by the `release` builtin).
const builtinNames: List<String> = List(
  "actionlint",
  "agnix",
  "aislop",
  "audit-skill",
  "cargo-deny",
  "claude-settings",
  "coderabbit",
  "commit-types",
  "conventional-commits",
  "dependabot",
  "gitignore",
  "hk",
  "inline-scripts",
  "mise",
  "plumber",
  "pr-agent",
  "pr-auto-rebase",
  "pull-request-template",
  "release",
  "release-automerge",
  "release-bump",
  "release-please",
  "rumdl",
  "rust-ci",
  "rust-toolchain",
  "scaffold-check",
  "security",
  "sync-labels",
  "upgrade",
  "zizmor"
)

/// The workflow recipes `options.workflowLayout` takes: groups of builtins that can be rendered as one workflow (`Builtins/Recipes.pkl`). A recipe is not
/// a builtin, so it is not in `builtinNames` and `options.without` does not take it.
const workflowRecipes: List<String> = List("analysis")

/// A hard requirement: `dependent` cannot work without `needs`. Leaving `needs` out while `dependent` is present is an error. Only requirements
/// that nothing outside the scaffold can meet are listed: `mise` and `hk` are not, because a repository can supply `mise.toml` and `hk.pkl` itself
/// (docs/workflow-layer.md says what the scripts and workflows expect of them).
class Requirement {
  dependent: String
  needs: String
  /// What breaks without it, in one sentence; quoted in the error.
  reason: String
}

const requirements: List<Requirement> = List(
  new Requirement {
    dependent = "commit-types"
    needs = "conventional-commits"
    reason = "check-commit-types.sh reads the copy of the commit types inside .github/workflows/conventional-commits.yml"
  },
  new Requirement {
    dependent = "rust-ci"
    needs = "rust-toolchain"
    reason = "check-toolchain-version.sh reads the channel from rust-toolchain.toml and fails when there is none"
  },
  new Requirement {
    dependent = "rust-ci"
    needs = "cargo-deny"
    reason = "check-toolchain-version.sh also checks the toolchain lines of .github/workflows/cargo-deny.yml and fails when the file is missing"
  }
)

/// The tools `mise.toml` pins, and the builtins that need each one locally, through mise. A tool is present if any of its owners is. A use on a
/// GitHub runner does not count, because a workflow `run:` block has its own `jq` and `yq` there. `pkl` and the runner are in `alwaysTools`: the runner
/// starts pkl and `scaffold-check` and `upgrade` run the runner. docs/feature-toggles.md shows the table with the reason for each row, and a test
/// fails when a script or template names a tool whose builtin is not an owner here.
const toolOwners: Map<String, List<String>> = Map(
  "rust", List("rust-toolchain", "rust-ci"),
  "actionlint", List("actionlint"),
  "zizmor", List("zizmor"),
  "rumdl", List("rumdl"),
  "agnix", List("agnix"),
  "hk", List("hk"),
  "yq", List("hk", "inline-scripts"),
  "shellcheck", List("actionlint", "hk"),
  "jq", List("agnix", "inline-scripts", "release-automerge", "release-bump", "release-please")
)

const alwaysTools: List<String> = List("pkl", "runner")

class Present {
  /// The builtins that are left out, as the repository wrote them.
  without: List<String>

  /// `without`, validated. Fails, naming the builtins there are, when it has a name that is not a builtin (an empty name included) or names one twice,
  /// and fails, naming both builtins and the way out, when it leaves out a builtin that a builtin that is still present needs (`requirements`).
  fixed checked: List<String> =
    let (names = without)
    let (notBuiltins = names.filter((n) -> !builtinNames.contains(n)))
    let (violations = requirements.filter((r) -> !names.contains(r.dependent) && names.contains(r.needs)))
    if (!notBuiltins.isEmpty)
      throw("options.without names \(notBuiltins.map((n) -> "\"\(n)\"").join(", ")), which \(if (notBuiltins.length == 1) "is" else "are") not a builtin of this package version. Builtins: \(builtinNames.join(", "))")
    else if (names.toSet().length != names.length)
      throw("options.without names a builtin more than once: \(names.filter((n) -> names.count((m) -> m == n) > 1).toSet().toList().join(", "))")
    else if (!violations.isEmpty)
      throw(violations.map((r) -> "options.without leaves out \"\(r.needs)\", which \"\(r.dependent)\" needs: \(r.reason). Leave \"\(r.dependent)\" out too (options.without), or keep \"\(r.needs)\".").join("\n"))
    else
      names

  /// Whether the builtin called `name` is present: it is not in `without`. Validate `without` through `checked` first. A name that is not a builtin is an error, so a typo cannot silently never match.
  function has(name: String): Boolean =
    if (!builtinNames.contains(name))
      throw("\"\(name)\" is not a builtin of this package version. Builtins: \(builtinNames.join(", "))")
    else
      !without.contains(name)

  /// Every builtin name to whether it is present, for a template to read as `present["rumdl"]`. The subscript form, because names have hyphens.
  fixed presentFlags: Mapping<String, Boolean> = new Mapping<String, Boolean> {
    for (name in builtinNames) { [name] = has(name) }
  }

  /// Every tool `mise.toml` can pin to whether it is present, for a template to read as `tools["jq"]`.
  fixed toolFlags: Mapping<String, Boolean> = new Mapping<String, Boolean> {
    for (tool in alwaysTools) { [tool] = true }
    for (tool, owners in toolOwners) { [tool] = owners.any((o) -> has(o)) }
  }
}

/// The `Present` value for these options. Reading it fails when `options.without` is invalid (see `Present.checked`).
function forOptions(opts: Config.Options): Present =
  let (checked = (new Present { without = opts.without.toList() }).checked)
  let (problem = optionProblem(opts, checked))
  if (problem != null) throw(problem) else new Present { without = checked }

/// What is wrong with the release options, or null. They are checked here because every aggregator reads `forOptions`, and pkl only evaluates
/// what something reads.
local function optionProblem(opts: Config.Options, without: List<String>): String? =
  let (notRecipes = opts.workflowLayout.keys.toList().filter((k) -> !workflowRecipes.contains(k)))
  if (!notRecipes.isEmpty)
    "options.workflowLayout names \(notRecipes.map((n) -> "\"\(n)\"").join(", ")), which \(if (notRecipes.length == 1) "is" else "are") not a workflow recipe of this package version. Recipes: \(workflowRecipes.join(", "))"
  else if (opts.releaseShape == "draft" && opts.binary)
    "options.releaseShape = \"draft\" cannot be used with options.binary = true: cargo-dist creates the GitHub Release of a repository with a binary. Use releaseShape = \"cargo-dist\" (or leave it unset), or set binary = false."
  else if (opts.versionCommitScope != null && opts.versionFile == null)
    "options.versionCommitScope is set but options.versionFile is not: the scope is only used by the release-bump workflow, which needs versionFile."
  else if (opts.versionFile != null && opts.resolvedReleaseShape() != "draft")
    "options.versionFile needs options.releaseShape = \"draft\": the release-bump workflow waits for the release workflow that publishes a release-please draft, and only that shape is supported. This repository's release shape is \"\(opts.resolvedReleaseShape())\"."
  else if (opts.versionFile != null && (opts.versionFile.contains("'") || opts.versionFile.contains("\n") || opts.versionFile.startsWith("/") || opts.versionFile.contains("..")))
    "options.versionFile must be a plain path inside the repository: no single quote, no newline, no leading slash and no \"..\", because the release-bump script and its API calls use it as written."
  else if (opts.versionFile != null && without.contains("release-bump"))
    "options.versionFile is set but options.without leaves out \"release-bump\", which is the builtin that uses it. Remove one of the two."
  else providerProblem(opts.prAgentProviders.toList())

/// What is wrong with `options.prAgentProviders`, or null. The secret, the variable and the model are written into the workflow (into a `${{ }}`
/// expression, an environment key and a list in a string), so each is checked and a typo is an error here and not a broken workflow.
local function providerProblem(providers: List<Config.Provider>): String? =
  let (secretShape = Regex(#"[A-Z][A-Z0-9_]*"#))
  let (envShape = Regex(#"[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*"#))
  let (modelShape = Regex(#"[A-Za-z0-9][A-Za-z0-9._:/+-]*"#))
  let (badSecret = providers.findOrNull((p) -> !p.secret.matches(secretShape)))
  let (badEnv = providers.findOrNull((p) -> !p.env.matches(envShape)))
  let (badModel = providers.findOrNull((p) -> !p.model.matches(modelShape)))
  if (providers.isEmpty)
    "options.prAgentProviders is empty: list at least one provider (model, secret, env), or choose reviewBot = \"coderabbit\"."
  else if (badModel != null)
    "options.prAgentProviders has the model \"\(badModel.model)\", which is not a plain model id: use letters, digits and . _ : / + - only, because it is written into the workflow."
  else if (badSecret != null)
    "options.prAgentProviders has the secret \"\(badSecret.secret)\", which is not a secret name: use capital letters, digits and _, starting with a letter, because it is written into a `${{ secrets.NAME }}` expression."
  else if (badEnv != null)
    "options.prAgentProviders has the env \"\(badEnv.env)\", which is not a variable name: use letters, digits and _, with dots only between parts for a pr-agent setting such as `SECTION.KEY`."
  else if (providers.map((p) -> p.model).distinct.length != providers.length)
    "options.prAgentProviders lists the same model twice: each provider needs its own model, and the order is the order of fallback."
  else if (providers.any((a) -> providers.any((b) -> a.env == b.env && a.secret != b.secret)))
    "options.prAgentProviders passes one env to two different secrets: models of one provider share an env and a secret, so give every entry of that env the same secret."
  else null
