// Replaces the steps of the Rust CI job with a single one.
import "@PACKAGE@/Steps.pkl"
import "@PACKAGE@/Workflows.pkl"

function rustCi(base: Workflows.Workflow): Workflows.Workflow = (base) {
  jobs { ["build-test"] { steps = new Listing<Steps.Step> { new Steps.Step { name = "Only step"; run = "echo only" } } } }
}
