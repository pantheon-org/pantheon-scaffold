/// INTERNAL. The steps and values that more than one builtin uses, moved out of `Builtins.pkl` unchanged. This module is not part of the
/// package's API and not of the Presets API (docs/presets-design.md): import `Builtins.pkl`, not this file. It can change without notice.
/// Pkl cannot import a `local` member, which is why these are not `local`.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Shared

import "../Config.pkl"
import "../Pins.pkl"
import "../Tools.pkl"

function mainTriggers(): Mapping<String, Any?> = new Mapping<String, Any?> {
  ["pull_request"] = new Mapping {
    ["types"] = new Listing { "opened"; "synchronize"; "reopened" }
    ["branches"] = new Listing { "main" }
  }
  ["push"] = new Mapping { ["branches"] = new Listing { "main" } }
}

concurrencyPerRef: Mapping<String, Any> = new Mapping {
  ["group"] = "${{ github.workflow }}-${{ github.ref }}"
  ["cancel-in-progress"] = true
}

readOnly: Mapping<String, String> = new Mapping { ["contents"] = "read" }

checkout: Config.Step = new {
  uses = Pins.checkout
  `with` = new Mapping { ["persist-credentials"] = false }
}

function installToolchain(toolchain: String, components: String?): Config.Step = new {
  name = "Install Rust toolchain"
  run =
    if (components == null)
      "rustup toolchain install \(toolchain) --profile minimal\nrustup default \(toolchain)\n"
    else
      "rustup toolchain install \(toolchain) --profile minimal --component \(components)\nrustup default \(toolchain)\n"
}

function mintToken(opts: Config.Options): Config.Step = new {
  name = "Mint pantheon-ai-bot token"
  id = "app-token"
  uses = Pins.createGithubAppToken
  `with` = new Mapping {
    ["client-id"] = opts.appClientId
    ["private-key"] = "${{ secrets.GH_APP_PRIVATE_KEY }}"
    ["permission-contents"] = "write"
    ["permission-pull-requests"] = "write"
  }
}

checkoutScripts: Config.Step = new {
  name = "Checkout scripts"
  uses = Pins.checkout
  `with` = new Mapping {
    ["persist-credentials"] = false
    ["sparse-checkout"] = ".github/scripts"
  }
}

function needSkillName(opts: Config.Options): String =
  opts.skillName ?? throw("options.skillName is required when options.skills is true: it names the folder under skills/ that audit-skill.yml, .coderabbit.yaml and SECURITY.md refer to. Set skillName, or set skills = false.")

function needCrateName(opts: Config.Options): String =
  opts.crateName ?? throw("options.crateName is required when options.binary is true: tag-release.sh and SECURITY.md name the crate. Set crateName, or set binary = false.")

function miseSetup(): List<Config.Step> = List(
  checkout,
  new Config.Step {
    uses = Pins.miseAction
    `with` = new Mapping {
      ["version"] = Tools.mise
      ["install"] = false
      ["cache"] = false
    }
  }
)

/// The names of the builtins, one for each folder of `pkl/Builtins/`: `options.without` takes these names. A test compares this list with the
/// folder listing, so the two cannot drift. A workflow key can differ from the name (`dist-check` is rendered by the `release` builtin).
const builtinNames: List<String> = List(
  "actionlint",
  "agnix",
  "aislop",
  "audit-skill",
  "cargo-deny",
  "claude-settings",
  "coderabbit",
  "commit-types",
  "conventional-commits",
  "dependabot",
  "gitignore",
  "hk",
  "inline-scripts",
  "mise",
  "plumber",
  "pr-auto-rebase",
  "pull-request-template",
  "release",
  "release-automerge",
  "release-please",
  "rumdl",
  "rust-ci",
  "rust-toolchain",
  "scaffold-check",
  "security",
  "sync-labels",
  "upgrade",
  "zizmor"
)

/// Which builtins are present: every one except those `options.without` leaves out. `Builtins.pkl` builds it with `present(opts)` and passes it to
/// the builtins that depend on another.
class Present {
  /// The builtins that are left out.
  without: List<String>

  /// Whether the builtin called `name` is present. A name that is not a builtin is an error, so a typo cannot silently never match.
  function has(name: String): Boolean =
    if (!builtinNames.contains(name))
      throw("\"\(name)\" is not a builtin of this package version. Builtins: \(builtinNames.join(", "))")
    else
      !without.contains(name)
}

/// A hard requirement: `dependent` cannot work without `needs`. Leaving `needs` out while `dependent` is present is an error. Only requirements
/// that nothing outside the scaffold can meet are listed: `mise` and `hk` are not, because a repository can supply `mise.toml` and `hk.pkl` itself
/// (docs/workflow-layer.md says what the scripts and workflows expect of them).
class Requirement {
  dependent: String
  needs: String
  /// What breaks without it, in one sentence; quoted in the error.
  reason: String
}

const requirements: List<Requirement> = List(
  new Requirement {
    dependent = "commit-types"
    needs = "conventional-commits"
    reason = "check-commit-types.sh reads the copy of the commit types inside .github/workflows/conventional-commits.yml"
  },
  new Requirement {
    dependent = "rust-ci"
    needs = "rust-toolchain"
    reason = "check-toolchain-version.sh reads the channel from rust-toolchain.toml and fails when there is none"
  },
  new Requirement {
    dependent = "rust-ci"
    needs = "cargo-deny"
    reason = "check-toolchain-version.sh also checks the toolchain lines of .github/workflows/cargo-deny.yml and fails when the file is missing"
  }
)

/// The `Present` value for these options. Fails, naming the builtins there are, when `options.without` has a name that is not a builtin
/// (an empty name included) or names one twice, and fails, naming both builtins and the way out, when it leaves out a builtin that a builtin
/// that is still present needs (`requirements`).
function present(opts: Config.Options): Present =
  let (names = opts.without.toList())
  let (notBuiltins = names.filter((n) -> !builtinNames.contains(n)))
  let (violations = requirements.filter((r) -> !names.contains(r.dependent) && names.contains(r.needs)))
  if (!notBuiltins.isEmpty)
    throw("options.without names \(notBuiltins.map((n) -> "\"\(n)\"").join(", ")), which \(if (notBuiltins.length == 1) "is" else "are") not a builtin of this package version. Builtins: \(builtinNames.join(", "))")
  else if (names.toSet().length != names.length)
    throw("options.without names a builtin more than once: \(names.filter((n) -> names.count((m) -> m == n) > 1).toSet().toList().join(", "))")
  else if (!violations.isEmpty)
    throw(violations.map((r) -> "options.without leaves out \"\(r.needs)\", which \"\(r.dependent)\" needs: \(r.reason). Leave \"\(r.dependent)\" out too (options.without), or keep \"\(r.needs)\".").join("\n"))
  else
    new Present { without = names }
