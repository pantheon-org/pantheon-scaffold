/// The coderabbit builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Coderabbit

import "../../Config.pkl"
import "../Shared.pkl"

/// The files of this builtin that `parameterisedFiles()` renders.
function parameterisedFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  [".coderabbit.yaml"] = new Config.GenFile {
    content =
      let (text = read("assets/coderabbit.yaml.tmpl").text)
      if (opts.skills)
        text.replaceAll("@@SKILL@@", Shared.needSkillName(opts))
      else
        text.replaceAll("    # Covered by the Audit Skill workflow; avoid a second opinion on the same diff.\n    - \"!skills/@@SKILL@@/**\"\n", "")
  }
}
