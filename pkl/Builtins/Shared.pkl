/// INTERNAL. The steps and values that more than one builtin uses, moved out of `Builtins.pkl` unchanged. This module is not part of the
/// package's API and not of the Presets API (docs/presets-design.md): import `Builtins.pkl`, not this file. It can change without notice.
/// Pkl cannot import a `local` member, which is why these are not `local`.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Shared

import "../Config.pkl"
import "../Jobs.pkl"
import "../Steps.pkl"
import "../Pins.pkl"
import "../Tools.pkl"

function mainTriggers(): Mapping<String, Any?> = new Mapping<String, Any?> {
  ["pull_request"] = new Mapping {
    ["types"] = new Listing { "opened"; "synchronize"; "reopened" }
    ["branches"] = new Listing { "main" }
  }
  ["push"] = new Mapping { ["branches"] = new Listing { "main" } }
}

concurrencyPerRef: Mapping<String, Any> = new Mapping {
  ["group"] = "${{ github.workflow }}-${{ github.ref }}"
  ["cancel-in-progress"] = true
}

readOnly: Mapping<String, String> = new Mapping { ["contents"] = "read" }

checkout: Steps.Step = new {
  uses = Pins.checkout
  `with` = new Mapping { ["persist-credentials"] = false }
}

function installToolchain(toolchain: String, components: String?): Steps.Step = new {
  name = "Install Rust toolchain"
  run =
    if (components == null)
      "rustup toolchain install \(toolchain) --profile minimal\nrustup default \(toolchain)\n"
    else
      "rustup toolchain install \(toolchain) --profile minimal --component \(components)\nrustup default \(toolchain)\n"
}

function mintToken(opts: Config.Options): Steps.Step = new {
  name = "Mint pantheon-ai-bot token"
  id = "app-token"
  uses = Pins.createGithubAppToken
  `with` = new Mapping {
    ["client-id"] = opts.appClientId
    ["private-key"] = "${{ secrets.GH_APP_PRIVATE_KEY }}"
    ["permission-contents"] = "write"
    ["permission-pull-requests"] = "write"
  }
}

checkoutScripts: Steps.Step = new {
  name = "Checkout scripts"
  uses = Pins.checkout
  `with` = new Mapping {
    ["persist-credentials"] = false
    ["sparse-checkout"] = ".github/scripts"
  }
}

function miseSetup(): List<Steps.Step> = List(
  checkout,
  new Steps.Step {
    uses = Pins.miseAction
    `with` = new Mapping {
      ["version"] = Tools.mise
      ["install"] = false
      ["cache"] = false
    }
  }
)


/// Merges the jobs of several sources into one mapping, in order. `parts` pairs a source name with its jobs. Fails, naming both sources, when two
/// sources have a job with the same id: a silent overwrite would drop a job from the rendered workflow.
function compose(parts: List<Pair<String, Mapping<String, Jobs.Job>>>): Mapping<String, Jobs.Job> =
  let (ids = parts.flatMap((p) -> p.second.keys.toList().map((id) -> Pair(id, p.first))))
  let (clash = ids.findOrNull((a) -> ids.count((b) -> b.first == a.first) > 1))
  if (clash != null)
    throw("job \"\(clash.first)\" is in more than one part: \(ids.filter((i) -> i.first == clash.first).map((i) -> i.second).join(" and ")). Job ids must be unique in a composed workflow.")
  else
    new Mapping<String, Jobs.Job> {
      for (p in parts) { ...p.second }
    }
