/// Helpers for a Preset: a pkl file under presets/ that takes a Builtin and returns a changed one (docs/presets-design.md).
/// The helpers that change a whole mapping fail when what they are asked to change does not exist. Plain pkl does not: amending a workflow
/// that a newer package no longer has silently creates an empty one, so a Preset would stop working without anyone being told. The helpers
/// that change one object are methods of it: `Workflow.amendJob`, `Job.amendStep`, `Job.insertStepsBefore`.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Presets

import "GenFiles.pkl"
import "Workflows.pkl"

/// Applies `change` to the workflow `key` of `base` and returns the whole mapping. Fails, naming the builtins there are, when `base` has no such workflow.
function amendWorkflow(
  base: Mapping<String, Workflows.Workflow>,
  key: String,
  change: (Workflows.Workflow) -> Workflows.Workflow
): Mapping<String, Workflows.Workflow> =
  if (!base.containsKey(key))
    throw("preset: workflow \"\(key)\" is not a builtin of this package version. Builtins: \(base.keys.toList().sort().join(", ")). A builtin that options.without leaves out is not in the mapping either.")
  else
    (base) { [key] = change.apply(base[key]) }

/// Applies `change` to the file at `path` in `base` and returns the whole mapping. Fails, naming the files there are, when `base` has no such file.
function amendFile(
  base: Mapping<String, GenFiles.GenFile>,
  path: String,
  change: (GenFiles.GenFile) -> GenFiles.GenFile
): Mapping<String, GenFiles.GenFile> =
  if (!base.containsKey(path))
    throw("preset: file \"\(path)\" is not rendered by the builtins of this package version. Files: \(base.keys.toList().sort().join(", ")). The files of a builtin that options.without leaves out are not rendered either.")
  else
    (base) { [path] = change.apply(base[path]) }

/// Replaces the context keys `overrides` names in the template file at `path`, and returns the whole mapping. `present` and `tools` are refused: they say what options.without leaves out. A key is replaced whole, never
/// merged. Fails, naming the keys there are, when the file has no template or the context has no such key, so a misspelt key cannot do nothing.
function amendContext(
  base: Mapping<String, GenFiles.GenFile>,
  path: String,
  overrides: Mapping<String, Any>
): Mapping<String, GenFiles.GenFile> =
  amendFile(base, path, (f) -> f.withContext(path, overrides))
