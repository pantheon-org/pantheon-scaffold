// Tries to replace the flags that say which builtins are present, which the package refuses.
import "@PACKAGE@/GenFiles.pkl"
import "@PACKAGE@/Presets.pkl"

function apply(files: Mapping<String, GenFiles.GenFile>): Mapping<String, GenFiles.GenFile> =
  Presets.amendContext(files, "mise.toml", new Mapping { ["present"] = new Mapping { ["hk"] = true } })
