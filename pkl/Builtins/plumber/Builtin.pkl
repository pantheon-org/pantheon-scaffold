/// The Plumber builtin: the CI/CD security scan of a repository's workflows, and the `.plumber.yaml` it reads. `Builtins.pkl` re-exports both
/// as `plumber()` and, through `workflowFiles()`, the file. Import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Plumber

import "../../Config.pkl"
import "../../Pins.pkl"
import "../Shared.pkl"

/// The CI/CD security scan of the repository's workflows (Plumber). Only a Critical finding blocks a pull request.
function workflow(): Config.Workflow = new {
  header = #"""
    CI/CD security scan of this repository's GitHub Actions workflows (unpinned
    actions, untrusted shell input, over-broad permissions). Findings surface in the
    Security tab (Code Scanning SARIF).

    Gating model (ported from pantheon-org/tekhne): Critical findings BLOCK the PR;
    everything else is visible in Code Scanning and never blocks. The Plumber action
    runs with soft-fail + continue-on-error so its own A-E score gate and any
    transient runtime error never block; the ONLY blocking signal is a Critical
    finding in the gate step below. Config lives in .plumber.yaml.

    Generated by pantheon-scaffold from pantheon.pkl: change it there, not in this file.
    """#
  name = "Plumber"
  on = new Mapping<String, Any?> {
    ...Shared.mainTriggers()
    ["schedule"] = new Listing { new Mapping { ["cron"] = "41 3 * * 1" } }
  }
  permissions = Shared.readOnly
  concurrency = Shared.concurrencyPerRef
  jobs {
    ["plumber"] {
      name = "Plumber Score"
      `runs-on` = "ubuntu-24.04"
      `timeout-minutes` = 5
      permissions = new Mapping {
        ["contents"] = "read"
        ["security-events"] = "write"
      }
      steps {
        Shared.checkout
        new {
          id = "plumber"
          uses = Pins.plumber
          `continue-on-error` = true
          `with` = new Mapping {
            ["soft-fail"] = "true"
            ["score-push"] = "false"
            ["output"] = "results.json"
          }
        }
        new {
          name = "Gate on Critical findings"
          run = #"""
            if [ ! -f results.json ]; then
              echo "::warning::results.json not found; Plumber did not produce a report (likely a transient scan error). Critical gate skipped this run."
              exit 0
            fi
            critical="$(jq '.plumberScore.counts.critical // 0' results.json)"
            if [ "$critical" -gt 0 ]; then
              echo "::error::${critical} Critical-severity Plumber finding(s) present; see the Code Scanning alerts for detail."
              jq -r '(.plumberScore.codeLosses // [])[] | select(.severity == "critical") | "::error::[\(.code)] \(.count) Critical-severity finding(s)"' results.json
              exit 1
            fi
            echo "No Critical-severity Plumber findings. Gate passed."\#n
            """#
        }
      }
    }
  }
}

/// The verbatim configuration the workflow reads.
function files(): Mapping<String, Config.GenFile> = new {
  [".plumber.yaml"] = new Config.GenFile { content = read("assets/plumber.yaml").text }
}
