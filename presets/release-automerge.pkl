// How this repository releases (docs/release-process.md): release-please opens the release pull request, you merge it, and release.yml
// publishes the draft release that release-please made. The Builtins describe the repositories that do not do it this way, so this Preset
// puts the schedule behind a switch (manual by default) and corrects the two headers.
import "../pkl/Presets.pkl"
import "../pkl/Workflows.pkl"

function apply(workflows: Mapping<String, Workflows.Workflow>): Mapping<String, Workflows.Workflow> =
  Presets.amendWorkflow(
    Presets.amendWorkflow(workflows, "release-please", (w) -> (w) {
      header = #"""
        Keeps one rolling release PR up to date on every push to main (version in pkl/PklProject,
        CHANGELOG.md and the manifest, from conventional commits). When that PR is merged the same
        run creates the vX.Y.Z tag and a DRAFT release (draft and force-tag-creation in
        release-please-config.json). The tag starts release.yml, which builds the assets and
        publishes the draft as a pre-release (docs/release-process.md).
        Ported from pantheon-org/tekhne and changed for this repository.

        Uses the pantheon-ai-bot App token because a tag created with GITHUB_TOKEN does not
        trigger other workflows. Needs the org secret GH_APP_PRIVATE_KEY.
        """#
    }),
    "release-automerge",
    (w) -> (w) {
      header = #"""
        Squash-merges the open release-please PR under the pantheon-ai-bot App token, so the push
        to main fires release-please.yml, which then tags the version. Merging the release PR is
        the go for a release, so this runs only by hand (Run workflow) unless the repository
        variable RELEASE_AUTOMERGE_SCHEDULE is set to true: then the Monday schedule merges the
        release PR when there is one, which is only when there are releasable commits. Without the
        variable a scheduled run is skipped. Needs the org secret GH_APP_PRIVATE_KEY.
        """#
    }.amendJob("automerge", (j) -> (j) {
      `if` = "github.event_name != 'schedule' || vars.RELEASE_AUTOMERGE_SCHEDULE == 'true'"
    })
  )
