/// Entry module of the pantheon-scaffold package. A repository amends this module in its
/// scaffold.pkl, sets `options`, `workflows` and `files`, and the runner reads the one JSON
/// document this module renders (decision 44, contract.schema.json).
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Config

import "pkl:reflect"
import "Pins.pkl"
import "GenFiles.pkl"
import "Workflows.pkl"

/// Version of the JSON document. The runner rejects any other value.
const schemaVersion: Int = 2

/// The oldest runner that can render this package. Raise it by hand in the release that needs a newer runner.
const requiresRunner: String = "0.0.0"

/// One LLM provider of the pr-agent review: a model, the repository secret that holds its key, and the variable pr-agent or litellm reads the key from.
class Provider {
  /// The litellm model id, for example `provider/model-name`. The first provider of `prAgentProviders` is the primary model, the rest are fallbacks.
  model: String
  /// The name of the repository secret that holds the key.
  secret: String
  /// The variable the key is passed in. It is the name pr-agent or litellm reads (a pr-agent setting has dots in it), and a provider whose variable they do not read silently does not work.
  env: String
}

class Options {
  /// The Rust toolchain, one source for every file that names it.
  toolchain: String
  /// The runner version pinned in mise.toml. Left unset it is read from the version of the package that rendered the file, because the
  /// runner and the package are released together. A package loaded from a folder has no version, so set this to use the mise builtin there.
  runnerVersion: String?
  /// `all` builds, lints and tests with `--all-features`, as the library repository does. Read by the hook steps and by rust-ci.yml.
  features: ("default"|"all") = "default"
  /// The client id of the GitHub App the pr-auto-rebase and release-automerge workflows mint their token from (a public identifier, not a
  /// secret). The default is the org's pantheon-ai-bot App, as the four repositories use it today.
  appClientId: String = "Iv23ligzn16vkDCWfHgc"
  /// Whether the repository builds a binary released with cargo-dist (the `binary` toggle). Needs `crateName`. Owns dist-workspace.toml,
  /// .github/actionlint.yaml, .github/scripts/tag-release.sh, .github/zizmor.yml and the external release.yml. Without a binary there is no
  /// generated release.yml, so release-please does not tag the crate itself and zizmor has no config file to read.
  binary: Boolean = true
  /// Whether the repository carries a skill (the `skills` toggle). Needs `skillName`. Owns audit-skill.yml, the skill lines of .coderabbit.yaml
  /// and SECURITY.md, and the wording of the agnix files.
  skills: Boolean = true
  /// Whether the repository has its own composite action, action.yml, which zizmor then scans too (the `compositeAction` toggle).
  compositeAction: Boolean = false
  /// The crate whose Cargo.toml release-please bumps. Named by the header of release-please.yml, tag-release.sh and SECURITY.md. Needed when `binary` is on.
  crateName: String?
  /// The skill folder name under `skills/`, for the files that refer to it (audit-skill.yml, .coderabbit.yaml, SECURITY.md). Needed when `skills` is on.
  skillName: String?
  /// Git dependencies pinned by tag that Dependabot cannot resolve, so it must ignore them.
  gitDependencyIgnore: Listing<String> = new {}
  /// Builtins to leave out, by name: the folder names under `pkl/Builtins/` (`rumdl`, `pull-request-template`, `mise` and the rest). Empty by default,
  /// so every builtin is present. The aggregators in Builtins.pkl skip a left-out builtin, and a builtin that cannot work without another fails with
  /// an error that names both. A name that is not a builtin, or one listed twice, is an error. Only the aggregators read it: calling a single builtin
  /// function (`rustCi(opts)`) still renders it, and not spreading an aggregator is not leaving its builtins out.
  without: Listing<String> = new {}
  /// How the workflows of a group of builtins are laid out, by recipe name. `separate` (the default for every recipe, and for a recipe not listed) renders
  /// one workflow file for each builtin. `merged` renders one workflow file for the recipe, with a job for each builtin that is present. The only recipe is
  /// `analysis`: zizmor, agnix, aislop and plumber as `analysis.yml`. `without` still switches each builtin off by its own name, in both layouts. This
  /// is not a toggle: it removes nothing, it changes the shape. A name that is not a recipe is an error that lists the recipes.
  workflowLayout: Mapping<String, "separate"|"merged"> = new {}
  /// How a release is made, for the header of release-please.yml and for the files that go with it. `cargo-dist`: cargo-dist creates the GitHub Release
  /// and release-please only tags (tag-release.sh). `published`: release-please publishes the release itself. `draft`: release-please makes the tag and a
  /// draft release, and the repository's own release workflow runs `.github/scripts/publish-release.sh` on the tag to publish it. Left unset it follows
  /// `binary`: `cargo-dist` with a binary, otherwise `published`. `draft` cannot be used with a binary.
  releaseShape: ("cargo-dist"|"published"|"draft")?
  /// `variable`: the Monday schedule of release-automerge.yml only runs when the repository variable RELEASE_AUTOMERGE_SCHEDULE is `true`, so a release
  /// pull request is merged by hand unless the repository switches the schedule on. `always`: the schedule always runs, as it did before.
  releaseAutomerge: ("variable"|"always") = "variable"
  /// The file whose `version = "x.y.z"` line the release-bump workflow sets to the next patch after a release, for a repository that cannot rebuild a
  /// published version (a pkl package). Needs `releaseShape = "draft"`. Unset, the release-bump builtin renders nothing.
  versionFile: String?
  /// The commit scope of the release-bump pull request, for example `pkl` gives `chore(pkl): start 1.2.4`. Needs `versionFile`.
  versionCommitScope: String?
  /// Whether dependabot.yml has a github-actions entry. Its `exclude-paths` lists every workflow the package renders, so a repository whose workflows are
  /// all rendered leaves the entry nothing to scan and Dependabot fails with `dependency_file_not_found`. `auto` (the default) renders the entry when the
  /// repository has something the package knows lies outside that list: a binary (cargo-dist's release.yml), a composite action (action.yml), the `draft`
  /// release shape (its own release workflow), or a workflow Builtin left out with `without` (that file is then the repository's own). A repository with
  /// workflows of its own and none of those, or an `action.yml` without `compositeAction`, sets `on`. `off` leaves the entry out.
  dependabotGithubActions: ("auto"|"on"|"off") = "auto"
  /// Whether release-please-config.json and .release-please-manifest.json are seeded (written once, never overwritten). Set it to false when the
  /// repository keeps its release-please configuration somewhere else.
  seedReleaseConfig: Boolean = true
  /// The event that starts the "Conventional Commit Title" workflow. `pull_request` (the default) needs no token and no checkout, because the workflow only reads
  /// the pull request title. `pull_request_target` is the trigger the workflow was first written with; GitHub blocks it on public repositories by default
  /// (brownouts from November 2026, enforced from 2 December 2026) unless an Actions event policy allows it. With `pull_request_target` the workflow is
  /// the same as the pantheon-adr copy. A `pull_request` run uses the workflow file of the pull request branch; a `pull_request_target` run uses the base branch's.
  conventionalCommitsEvent: ("pull_request"|"pull_request_target") = "pull_request"
  /// Which pull request review bot is rendered. `auto` (the default) is `pr-agent`, unless the repository already has a `.coderabbit.yaml`, then it is
  /// `coderabbit`: the runner looks for the file and tells the package (docs/feature-toggles.md). `pr-agent` and `coderabbit` choose it. CodeRabbit reviews
  /// repositories with more than 10 stars only. `without` still leaves either builtin out, and wins over this option.
  reviewBot: ("auto"|"pr-agent"|"coderabbit") = "auto"
  /// The LLM providers of the pr-agent workflow, in order: the first is the primary model, the others are fallbacks. One provider is valid. Each key is a
  /// repository secret, and the workflow skips cleanly when none of them is set.
  prAgentProviders: Listing<Provider> = new {
    new { model = "gemini/gemini-3.5-flash"; secret = "GEMINI_API_KEY"; env = "GOOGLE_AI_STUDIO.GEMINI_API_KEY" }
    new { model = "mistral/mistral-small-2603"; secret = "MISTRAL_API_KEY"; env = "MISTRAL.KEY" }
    new { model = "cerebras/gpt-oss-120b"; secret = "CEREBRAS_API_KEY"; env = "CEREBRAS_API_KEY" }
  }

  /// Whether dependabot.yml has a github-actions entry, from `dependabotGithubActions`. `workflowLeftOut` is whether `without` leaves out a workflow
  /// the repository would otherwise get (Builtins.dependabot works that out).
  function githubActionsUpdates(workflowLeftOut: Boolean): Boolean =
    if (dependabotGithubActions == "on") true
    else if (dependabotGithubActions == "off") false
    else binary || compositeAction || resolvedReleaseShape() == "draft" || workflowLeftOut

  /// The bot that is rendered: `reviewBot`, or for `auto` the one that follows from whether the repository has a `.coderabbit.yaml` (the runner passes that
  /// as the property `scaffold.coderabbitYaml`; a run without it, such as a plain `pkl eval`, reads it as false).
  function resolvedReviewBot(): "pr-agent"|"coderabbit" =
    if (reviewBot == "auto") (if (read?("prop:scaffold.coderabbitYaml") == "true") "coderabbit" else "pr-agent")
    else reviewBot as "pr-agent"|"coderabbit"

  /// `releaseShape`, or the shape that follows from `binary`.
  function resolvedReleaseShape(): String = releaseShape ?? (if (binary) "cargo-dist" else "published")

  /// `skillName`, or an error that says why it is needed. Read by the builtins that name the skill folder.
  function requireSkillName(): String =
    skillName ?? throw("options.skillName is required when options.skills is true: it names the folder under skills/ that audit-skill.yml, .coderabbit.yaml and SECURITY.md refer to. Set skillName, or set skills = false.")

  /// `crateName`, or an error that says why it is needed. Read by the builtins that name the crate.
  function requireCrateName(): String =
    crateName ?? throw("options.crateName is required when options.binary is true: tag-release.sh and SECURITY.md name the crate. Set crateName, or set binary = false.")
}

options: Options

/// The Preset files this configuration applies, by path under presets/. They are recorded in the contract so the runner can list them,
/// and hash them as inputs. A file in presets/ that no configuration lists is reported as unused.
presets: Listing<String> = new {}

/// Workflows by file name without extension. Builtins and custom workflows go here.
workflows: Mapping<String, Workflows.Workflow> = new {}

/// Files that are not workflows, by path.
files: Mapping<String, GenFiles.GenFile> = new {}

/// Every pin used by a step, de-duplicated by action and sha.
local usedPins: List<Pins.Pin> = workflows.toMap().values.flatMap((w) -> w.pins).distinct

/// Escape hatch accounting for gate B: uses over typed constructs (workflows, jobs and steps).
local escapeUses: Int = workflows.toMap().values.map((w) -> w.escapeUses).fold(0, (a, b) -> a + b)

/// Where this module was loaded from. For a released package that is its package:// URI, which carries the version.
local definingUri: String = reflect.Class(Options).enclosingDeclaration.uri

local constructCount: Int = workflows.toMap().values.map((w) -> w.constructs).fold(0, (a, b) -> a + b)

local generated: Map<String, GenFiles.GenFile> =
  workflows.toMap().mapKeys((k, _) -> ".github/workflows/\(k).yml")
    .mapValues((_, w) -> new GenFiles.GenFile { content = w.rendered; removeOnDetach = w.removeOnDetach })
  + files.toMap()

contract: Dynamic = new Dynamic {
  schemaVersion = module.schemaVersion
  files = generated.keys.toList().sort().map((filePath) ->
    let (f = generated[filePath])
      f.entry(filePath)
  ).toListing()
  pins = usedPins.sortWith((a, b) -> a.action < b.action).map((p) -> p.entry).toListing()
  escapeHatch = new Dynamic {
    uses = escapeUses
    constructs = constructCount
  }
  when (definingUri.startsWith("package://")) { packageUri = definingUri }
  when (module.presets.length > 0) { presets = module.presets }
  requires = new Dynamic { runner = requiresRunner }
}

output {
  renderer = new JsonRenderer { omitNullProperties = true }
  value = contract
}
