/// Entry module of the pantheon-scaffold package. A repository amends this module in its
/// pantheon.pkl, sets `options`, `workflows` and `files`, and the runner reads the one JSON
/// document this module renders (decision 44, contract.schema.json).
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Config

import "pkl:reflect"
import "Pins.pkl"

/// Version of the JSON document. The runner rejects any other value.
const schemaVersion: Int = 1

/// The oldest runner that can render this package. Raise it by hand in the release that needs a newer runner.
const requiresRunner: String = "0.0.0"

class Options {
  /// The Rust toolchain, one source for every file that names it.
  toolchain: String
  /// The runner version pinned in mise.toml. Left unset it is read from the version of the package that rendered the file, because the
  /// runner and the package are released together. A package loaded from a folder has no version, so set this to use the mise builtin there.
  runnerVersion: String?
  /// `all` builds, lints and tests with `--all-features`, as the library repository does. Read by the hook steps now, and by the Rust CI
  /// workflow when the toggles are wired in (phase 5).
  features: ("default"|"all") = "default"
  /// The client id of the GitHub App the pr-auto-rebase and release-automerge workflows mint their token from (a public identifier, not a
  /// secret). The default is the org's pantheon-ai-bot App, as the four repositories use it today.
  appClientId: String = "Iv23ligzn16vkDCWfHgc"
  /// Whether the repository builds a binary released with cargo-dist (the `binary` toggle, phase 5). Without one there is no generated
  /// release.yml, so release-please does not tag the crate itself and zizmor has no config file to read.
  binary: Boolean = true
  /// Whether the repository carries a skill that agnix lints (the `skills` toggle, phase 5). Today it only changes comment wording.
  skills: Boolean = true
  /// Whether the repository has its own composite action, action.yml, which zizmor then scans too (the `compositeAction` toggle).
  compositeAction: Boolean = false
  /// The crate whose Cargo.toml release-please bumps. Only the header comment of release-please.yml names it.
  crateName: String?
  /// The skill folder name under `skills/`, for the files that refer to it (audit-skill.yml, .coderabbit.yaml, SECURITY.md). Needed when `skills` is on.
  skillName: String?
  /// Git dependencies pinned by tag that Dependabot cannot resolve, so it must ignore them.
  gitDependencyIgnore: Listing<String> = new {}
}

/// A workflow step. Typed keys cover what the workflows use. `raw` is the escape hatch (decision 33):
/// its keys are merged over the typed ones, and every use is counted for gate B.
class Step {
  name: String?
  id: String?
  `continue-on-error`: Boolean?
  uses: (Pins.Pin|String)?
  run: String?
  `with`: Mapping<String, Any>?
  env: Mapping<String, Any>?
  `if`: String?
  `working-directory`: String?
  raw: Mapping<String, Any>?
}

class Job {
  name: String?
  `runs-on`: String = "ubuntu-latest"
  needs: Listing<String>?
  `if`: String?
  permissions: Mapping<String, String>?
  `timeout-minutes`: Int?
  env: Mapping<String, Any>?
  strategy: Mapping<String, Any>?
  steps: Listing<Step>
  raw: Mapping<String, Any>?
}

class Workflow {
  /// Rendered as `#` comment lines above the YAML.
  header: String?
  /// A comment on the `on:` line. A tool can act on it (zizmor's `ignore[...]`), so it has to be in the file.
  onComment: String?
  /// The runner deletes this workflow on `detach` (the consumer upgrade workflow, which would fail on every run once detached).
  removeOnDetach: Boolean = false
  name: String
  on: Mapping<String, Any?>
  permissions: Mapping<String, String>?
  concurrency: Mapping<String, Any>?
  env: Mapping<String, Any>?
  jobs: Mapping<String, Job>
  raw: Mapping<String, Any>?
}

typealias FileClass = "owned"|"seed"|"external"

class GenFile {
  /// owned: rewritten by the runner and refused if hand-edited. seed: written once.
  /// external: listed but never written, hashed or deleted (for example mise.lock).
  `class`: FileClass = "owned"
  /// Absent for an external file.
  content: String?
  executable: Boolean = false
  /// The runner deletes this owned file on `detach`, for a file that would fail on every run once detached (the consumer upgrade workflow).
  removeOnDetach: Boolean = false
}

options: Options

/// Workflows by file name without extension. Builtins and custom workflows go here.
workflows: Mapping<String, Workflow> = new {}

/// Files that are not workflows, by path.
files: Mapping<String, GenFile> = new {}

local yaml = new YamlRenderer { omitNullProperties = true }

local function pinRef(u: Pins.Pin|String): String =
  if (u is Pins.Pin) "\(u.action)@\(u.sha)" else u

local function renderStep(s: Step): Dynamic = new Dynamic {
  when (s.name != null) { name = s.name }
  when (s.id != null) { id = s.id }
  when (s.uses != null) { uses = pinRef(s.uses!!) }
  when (s.`if` != null) { `if` = s.`if` }
  when (s.`continue-on-error` != null) { `continue-on-error` = s.`continue-on-error` }
  when (s.run != null) { run = s.run }
  when (s.`with` != null) { `with` = s.`with` }
  when (s.env != null) { env = s.env }
  when (s.`working-directory` != null) { `working-directory` = s.`working-directory` }
  when (s.raw != null) { ...s.raw }
}

local function renderJob(j: Job): Dynamic = new Dynamic {
  when (j.name != null) { name = j.name }
  `runs-on` = j.`runs-on`
  when (j.needs != null) { needs = j.needs }
  when (j.`if` != null) { `if` = j.`if` }
  when (j.permissions != null) { permissions = j.permissions }
  when (j.`timeout-minutes` != null) { `timeout-minutes` = j.`timeout-minutes` }
  when (j.env != null) { env = j.env }
  when (j.strategy != null) { strategy = j.strategy }
  steps = j.steps.toList().map((s) -> renderStep(s)).toListing()
  when (j.raw != null) { ...j.raw }
}

/// Puts a comment on the `on:` line of the rendered YAML, where the key stands alone on its line. YamlRenderer quotes the key (`on` is a
/// YAML 1.1 boolean), so the line is `'on':`. Fails if neither form is found, so a comment that matters is never silently dropped.
local function withOnComment(comment: String?, text: String): String =
  if (comment == null) text
  else if (text.contains("\n'on':\n")) text.replaceFirst("\n'on':\n", "\n'on': # \(comment)\n")
  else if (text.contains("\non:\n")) text.replaceFirst("\non:\n", "\non: # \(comment)\n")
  else throw("onComment is set but the rendered YAML has no on: line to put it on")

local function commentBlock(text: String?): String =
  if (text == null) ""
  else text.split("\n").map((l) -> if (l == "") "#" else "# \(l)").join("\n") + "\n"

local function renderWorkflow(w: Workflow): String =
  commentBlock(w.header) + withOnComment(w.onComment, yaml.renderValue(new Dynamic {
    name = w.name
    on = w.on
    when (w.permissions != null) { permissions = w.permissions }
    when (w.concurrency != null) { concurrency = w.concurrency }
    when (w.env != null) { env = w.env }
    jobs = w.jobs.toMap().mapValues((_, j) -> renderJob(j)).toMapping()
    when (w.raw != null) { ...w.raw }
  }))

/// Every pin used by a step, de-duplicated by action and sha.
local usedPins: List<Pins.Pin> =
  workflows.toMap().values.flatMap((w) ->
    w.jobs.toMap().values.flatMap((j) ->
      j.steps.toList().filter((s) -> s.uses is Pins.Pin).map((s) -> s.uses as Pins.Pin)))
    .distinct

local allSteps: List<Step> =
  workflows.toMap().values.flatMap((w) -> w.jobs.toMap().values.flatMap((j) -> j.steps.toList()))
local allJobs: List<Job> = workflows.toMap().values.flatMap((w) -> w.jobs.toMap().values)

/// Escape hatch accounting for gate B: uses over typed constructs (workflows, jobs and steps).
local escapeUses: Int =
  workflows.toMap().values.filter((w) -> w.raw != null).length +
  allJobs.filter((j) -> j.raw != null).length +
  allSteps.filter((s) -> s.raw != null).length
/// Where this module was loaded from. For a released package that is its package:// URI, which carries the version.
local definingUri: String = reflect.Class(Options).enclosingDeclaration.uri

local constructCount: Int = workflows.length + allJobs.length + allSteps.length

local generated: Map<String, GenFile> =
  workflows.toMap().mapKeys((k, _) -> ".github/workflows/\(k).yml")
    .mapValues((_, w) -> new GenFile { content = renderWorkflow(w); removeOnDetach = w.removeOnDetach })
  + files.toMap()

contract: Dynamic = new Dynamic {
  schemaVersion = module.schemaVersion
  files = generated.keys.toList().sort().map((filePath) ->
    let (f = generated[filePath])
      new Dynamic {
        path = filePath
        `class` = f.`class`
        mode = if (f.executable) "0755" else "0644"
        when (f.`class` != "external") { content = f.content }
        when (f.removeOnDetach) { removeOnDetach = true }
      }
  ).toListing()
  pins = usedPins.sortWith((a, b) -> a.action < b.action).map((p) -> new Dynamic {
    action = p.action
    sha = p.sha
    version = p.version
  }).toListing()
  escapeHatch = new Dynamic {
    uses = escapeUses
    constructs = constructCount
  }
  when (definingUri.startsWith("package://")) { packageUri = definingUri }
  requires = new Dynamic { runner = requiresRunner }
}

output {
  renderer = new JsonRenderer { omitNullProperties = true }
  value = contract
}
