/// Values the builtin templates read that are not tool versions (those are in Tools.pkl). Each is defined once, here, and reaches a template
/// through the `context` of its file. A value that can change per repository or over time is here, and a fixed policy stays in the template.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Values

/// The workflow cargo-dist generates. Three tool configs name it, so the name is defined once.
const releaseWorkflow: String = "release.yml"

// cargo-dist (dist-workspace.toml)
const distTargets: List<String> = List("aarch64-apple-darwin", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin", "x86_64-unknown-linux-gnu")
const linuxRunner: String = "ubuntu-22.04"
const macosRunner: String = "macos-latest"
/// The actions cargo-dist's generated workflow uses, by commit. checkout is read from Pins.pkl.
const distUploadArtifactSha: String = "cf430e030ddbb5b0abf93d22962f4752f3646cd9"
const distDownloadArtifactSha: String = "9000827ccba6bdab643e8b6fd33ac0654aef8333"

// cargo-deny (deny.toml)
const denyLicences: List<String> = List(
  "MIT", "Apache-2.0", "Apache-2.0 WITH LLVM-exception", "BSD-2-Clause", "BSD-3-Clause", "ISC",
  "Unicode-3.0", "Zlib", "CC0-1.0", "MPL-2.0", "MIT-0", "CDLA-Permissive-2.0")
const denyIgnoreIds: List<String> = List("RUSTSEC-2024-0449")
/// The comment lines for the ignored advisories above, in order.
const denyIgnoreNote: List<String> = List(
  "RUSTSEC-2024-0449: unsafe-libyaml is archived, with no fix. It arrives through",
  "serde_yaml_ng, which every tool uses to read frontmatter. Revisit when",
  "serde_yaml_ng moves to a maintained YAML backend; remove this entry then.")
const denyAllowGit: List<String> = List("https://github.com/pantheon-org/pantheon-agentic-harness-dev-kit")

// rumdl (.rumdl.toml)
const rumdlDisabled: List<String> = List("MD060", "MD032", "MD013", "MD022", "MD024", "MD031", "MD037", "MD040", "MD047")
/// The pull request template the pull-request-template builtin renders, which rumdl must not hold to MD041.
const prTemplatePath: String = ".github/pull_request_template.md"

// plumber (.plumber.yaml)
const plumberTrustedOwners: List<String> = List("actions", "github")
const plumberTrustedActions: List<String> = List(
  "getplumber/plumber",
  "googleapis/release-please-action # Release automation (release-please.yml)",
  "peter-evans/find-comment # PR comment lookup (agnix.yml)",
  "peter-evans/create-or-update-comment # PR comment upsert (agnix.yml)",
  "zizmorcore/zizmor-action # Workflow security scan (zizmor.yml); published by the zizmor project's own org, pinned by SHA")
const plumberTrustedUrls: List<String> = List("https://github.com/axodotdev/cargo-dist/releases/download/*", "https://sh.rustup.rs")

// agnix (.agnix.toml)
const agnixTarget: String = "ClaudeCode"
class ExcludeEntry {
  path: String
  /// Printed on the line above the entry. Empty for none.
  comment: String = ""
}
const agnixExclude: List<ExcludeEntry> = List(
  new ExcludeEntry { path = "node_modules/**" },
  new ExcludeEntry { path = ".git/**" },
  new ExcludeEntry { path = "target/**" },
  new ExcludeEntry { path = "base/**"; comment = "The base-branch checkout the pull request job lints for comparison." },
  new ExcludeEntry { path = "**/tests/**"; comment = "Test fixtures hold deliberately broken skills." },
  new ExcludeEntry { path = "**/testdata/**" })
class DisabledRule {
  id: String
  reason: String
}
const agnixDisabledRules: List<DisabledRule> = List(
  new DisabledRule { id = "AS-013"; reason = "references deeper than one level: assets/ subfolders are the layout" },
  new DisabledRule { id = "XML-001"; reason = "prose placeholders such as <chart> read as unclosed tags" },
  new DisabledRule { id = "CC-SK-007"; reason = "unrestricted Bash: an opinion, not a defect" },
  new DisabledRule { id = "CC-SK-021"; reason = "example paths such as /home/runner read as leaked identity" })
/// The disabled rules as the lines of the list: the comments line up in one column.
const agnixDisabledRuleLines: List<String> =
  agnixDisabledRules.map((r) -> "\"\(r.id)\",".padEnd(14, " ") + "# \(r.reason)")

// actionlint (.github/actionlint.yaml): shellcheck findings in the generated release workflow that cannot be fixed by editing it.
class ShellcheckIgnore {
  code: String
  reason: String
}
const actionlintIgnores: List<ShellcheckIgnore> = List(
  new ShellcheckIgnore { code = "SC2086"; reason = "unquoted variables in dist's scripts." },
  new ShellcheckIgnore { code = "SC2129"; reason = "individual redirects to one file instead of a grouped block." })

// zizmor (.github/zizmor.yml): findings, by file, line and column, that existed when the gate was added and are deliberately not fixed.
// cargo-dist regenerates the release workflow, so these move when it does: update them when a finding reappears.
const zizmorExcessivePermissions: List<String> = List("\(releaseWorkflow):18:3")
const zizmorTemplateInjection: List<String> = List("\(releaseWorkflow):79:91")
const zizmorUnpinnedImages: List<String> = List("\(releaseWorkflow):110:40", "\(releaseWorkflow):110:66")
const zizmorGithubEnv: List<String> = List("action.yml:35:7")

// Claude Code settings (.claude/settings.json)
const claudeSettingsSchemaUrl: String = "https://json.schemastore.org/claude-code-settings.json"
const claudeSessionUrl: Boolean = false
