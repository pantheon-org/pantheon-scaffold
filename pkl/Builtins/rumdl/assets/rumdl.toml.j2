# rumdl configuration. Lint everything with: mise run lint   (or: rumdl check .)
# Same rules switched off as the tekhne configuration.

[global]
disable = [{% for r in disabled %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]
include = ["**/*.md"]
exclude = ["target/**"]

[MD010]
code-blocks = false

# The pull request template starts with an HTML comment and a level 2 heading, so MD041 can never pass for it.
# Every other file is still checked by MD041.
[per-file-ignores]
"{{ prTemplatePath }}" = ["MD041"]
