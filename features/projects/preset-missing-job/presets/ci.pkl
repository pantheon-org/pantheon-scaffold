// Names a job that the Rust CI workflow does not have, through the helpers that fail when the target does not exist.
import "@PACKAGE@/Workflows.pkl"
import "@PACKAGE@/Presets.pkl"

function apply(workflows: Mapping<String, Workflows.Workflow>): Mapping<String, Workflows.Workflow> =
  Presets.amendWorkflow(workflows, "rust-ci", (w) -> w.amendJob("build", (j) -> (j) { `timeout-minutes` = 30 }))
