// Narrows the licences cargo-deny allows, by changing the context of deny.toml.
import "@PACKAGE@/GenFiles.pkl"
import "@PACKAGE@/Presets.pkl"

function apply(files: Mapping<String, GenFiles.GenFile>): Mapping<String, GenFiles.GenFile> =
  Presets.amendContext(files, "deny.toml", new Mapping { ["licenses"] = List("MIT") })
