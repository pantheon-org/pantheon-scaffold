/// Reusable builtin workflows and files. A repository's pantheon.pkl calls these with its options,
/// and may override anything in the result. Pins live in Pins.pkl.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Builtins

import "pkl:reflect"
import "Config.pkl"
import "Pins.pkl"
import "Tools.pkl"
import "Builtins/Shared.pkl"

// Aliases of the shared helpers while builtins still sit in this file. Each goes when its last user moves into a folder.
local function mainTriggers(): Mapping<String, Any?> = Shared.mainTriggers()
local concurrencyPerRef: Mapping<String, Any> = Shared.concurrencyPerRef
local readOnly: Mapping<String, String> = Shared.readOnly
local checkout: Config.Step = Shared.checkout
local function installToolchain(toolchain: String, components: String?): Config.Step = Shared.installToolchain(toolchain, components)
local function mintToken(opts: Config.Options): Config.Step = Shared.mintToken(opts)
local checkoutScripts: Config.Step = Shared.checkoutScripts
local function needSkillName(opts: Config.Options): String = Shared.needSkillName(opts)
local function needCrateName(opts: Config.Options): String = Shared.needCrateName(opts)
local function miseSetup(): List<Config.Step> = Shared.miseSetup()

/// Checks the dependency tree against deny.toml.
function cargoDeny(opts: Config.Options): Config.Workflow = new {
  header = """
    Checks the dependency tree against deny.toml: RustSec advisories (including
    yanked and unmaintained crates), licences, banned or duplicate crates, and
    allowed registries and git sources. The advisory database changes without a
    commit here, so a weekly run catches new advisories on an idle repository.
    """
  name = "Cargo Deny"
  on = new Mapping<String, Any?> {
    ...mainTriggers()
    ["schedule"] = new Listing { new Mapping { ["cron"] = "17 5 * * 1" } }
    ["workflow_dispatch"] = new Mapping {}
  }
  permissions = readOnly
  concurrency = concurrencyPerRef
  jobs {
    ["cargo-deny"] {
      name = "Cargo Deny"
      `timeout-minutes` = 10
      steps {
        checkout
        installToolchain(opts.toolchain, null)
        new { name = "Check dependencies"; run = "bash .github/scripts/cargo-deny.sh" }
      }
    }
  }
}

/// Format, lint, build and test the Rust workspace. With `features = "all"` (the library repository) clippy, the build and the tests run with
/// `--all-features`, and an extra step builds with the default features.
function rustCi(opts: Config.Options): Config.Workflow =
  let (features = if (opts.features == "all") "--all-features " else "")
  new {
  name = "Rust CI"
  on = mainTriggers()
  permissions = readOnly
  concurrency = concurrencyPerRef
  jobs {
    ["build-test"] {
      name = "Build, test, lint"
      `timeout-minutes` = 15
      steps {
        checkout
        new { name = "Check toolchain versions"; run = "bash .github/scripts/check-toolchain-version.sh" }
        installToolchain(opts.toolchain, "rustfmt,clippy")
        new { name = "Format check"; run = "cargo fmt --all --check" }
        new { name = "Clippy"; run = "cargo clippy --workspace --all-targets \(features)--locked -- -D warnings" }
        new { name = "Build"; run = "cargo build --workspace \(features)--locked" }
        when (opts.features == "all") { new { name = "Build with default features"; run = "cargo build --workspace --locked" } }
        new { name = "Test"; run = "cargo test --workspace \(features)--locked" }
      }
    }
  }
}

/// A run block in a workflow or composite action may hold at most 15 lines of code.
function inlineScripts(): Config.Workflow = new {
  header = """
    Rule: a `run:` block in a workflow or composite action may hold at most 15 lines
    of code (blank and comment lines excluded). Longer logic belongs in a script under
    .github/scripts/, where it can be run locally, shellchecked and tested; the step
    then calls it. Values reach the script through `env:`, never by pasting `${{ }}`
    into its text. A block that must stay long can opt out with a line
    `# inline-ok: <reason>` inside it. Ported from pantheon-org/tekhne.

    No path filter, so the check always reports a conclusion; also runs on push to
    main as a post-merge safety net. Deterministic and offline.
    """
  name = "Inline Scripts"
  on = mainTriggers()
  permissions = readOnly
  concurrency = concurrencyPerRef
  jobs {
    ["inline-scripts"] {
      name = "Inline Scripts"
      `timeout-minutes` = 5
      steps {
        checkout
        new { name = "Check run blocks are short"; run = "bash .github/scripts/check-inline-scripts.sh" }
      }
    }
  }
}

/// The verbatim files the three builtins depend on.
function baseFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  ["rust-toolchain.toml"] = new Config.GenFile {
    content = read("assets/rust-toolchain.toml.tmpl").text.replaceAll("@@TOOLCHAIN@@", opts.toolchain)
  }
  ["deny.toml"] = new Config.GenFile { content = read("assets/deny.toml").text }
  [".github/scripts/cargo-deny.sh"] = new Config.GenFile { content = read("assets/cargo-deny.sh").text; executable = true }
  [".github/scripts/check-inline-scripts.sh"] = new Config.GenFile { content = read("assets/check-inline-scripts.sh").text; executable = true }
  [".github/scripts/check-toolchain-version.sh"] = new Config.GenFile { content = read("assets/check-toolchain-version.sh").text; executable = true }
}

/// The tooling files the four Rust repositories share, all verbatim: the seven shared scripts that `baseFiles` does not cover (with
/// `cargo-deny.sh` and `check-inline-scripts.sh` from there they are the nine shared scripts), the rumdl configuration and the Claude Code
/// settings. All nine scripts are executable. `sync-labels.sh` is not executable in the four repositories today, and its workflow runs
/// it with `bash`, so the bit never mattered. It is rendered executable like the other eight.
function toolingFiles(): Mapping<String, Config.GenFile> = new {
  [".github/scripts/agnix-assemble-comment.sh"] = new Config.GenFile { content = read("assets/agnix-assemble-comment.sh").text; executable = true }
  [".github/scripts/agnix-file-issues.sh"] = new Config.GenFile { content = read("assets/agnix-file-issues.sh").text; executable = true }
  [".github/scripts/agnix-introduced-errors.sh"] = new Config.GenFile { content = read("assets/agnix-introduced-errors.sh").text; executable = true }
  [".github/scripts/auto-rebase.sh"] = new Config.GenFile { content = read("assets/auto-rebase.sh").text; executable = true }
  [".github/scripts/check-commit-types.sh"] = new Config.GenFile { content = read("assets/check-commit-types.sh").text; executable = true }
  [".github/scripts/release-automerge.sh"] = new Config.GenFile { content = read("assets/release-automerge.sh").text; executable = true }
  [".github/scripts/sync-labels.sh"] = new Config.GenFile { content = read("assets/sync-labels.sh").text; executable = true }
  [".rumdl.toml"] = new Config.GenFile { content = read("assets/rumdl.toml").text }
  [".claude/settings.json"] = new Config.GenFile { content = read("assets/claude-settings.json").text }
}

/// The version of the package this module was loaded from, read from its package URI, or null for a package loaded from a folder.
local packageVersion: String? =
  let (matches = Regex(#"@([^@#/:]+)(?:::sha256:[0-9a-f]{64})?#"#).findMatchesIn(reflect.Class(Config.Options).enclosingDeclaration.uri))
    if (matches.isEmpty) null else matches.first.groups[1].value

/// mise.toml, owned by the runner, and the files around it: mise.lock (written by mise, so external) and a per-repository mise config,
/// seeded once. mise reads both config files, the second adds tools, and for a tool listed in both mise.toml wins (decision 29, checked
/// against real mise in mise.test.ts). The tool pins come from Tools.pkl and the runner pin from the package version.
function miseFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  let (runner = opts.runnerVersion ?? packageVersion ?? throw("runnerVersion is not set and the package version cannot be read from a package URI: set options.runnerVersion when the package is loaded from a folder"))
    new {
      ["mise.toml"] = new Config.GenFile {
        content =
          read("assets/mise.toml.tmpl").text
            .replaceAll("@@TOOLCHAIN@@", opts.toolchain)
            .replaceAll("@@ACTIONLINT@@", Tools.actionlint)
            .replaceAll("@@ZIZMOR@@", Tools.zizmor)
            .replaceAll("@@RUMDL@@", Tools.rumdl)
            .replaceAll("@@AGNIX@@", Tools.agnix)
            .replaceAll("@@RUNNER@@", runner)
            .replaceAll("@@MIN_RELEASE_AGE@@", Tools.minimumReleaseAge)
            .replaceAll("@@LOCKFILE_PLATFORMS@@", Tools.lockfilePlatforms.map((p) -> "\"\(p)\"").join(", "))
      }
      ["mise.lock"] = new Config.GenFile { `class` = "external" }
      [".mise/conf.d/repo.toml"] = new Config.GenFile { `class` = "seed"; content = read("assets/mise-repo.toml").text }
    }

/// The hook steps the four Rust repositories share (decision 31): `hk.shared.pkl`, owned by the runner, holds the steps, and `hk.pkl` is
/// seeded once, imports it and holds only the hooks. Each repository adds its own steps in `hk.pkl`. `options.features = "all"` is the
/// library repository's `--all-features` in the pre-push clippy and test steps. Checked against real hk in hk.test.ts.
function hkFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  ["hk.shared.pkl"] = new Config.GenFile {
    content =
      read("assets/hk.shared.pkl.tmpl").text
        .replaceAll("@@HK_VERSION@@", Tools.hkConfigVersion)
        .replaceAll("@@FEATURES@@", if (opts.features == "all") "--all-features " else "")
  }
  ["hk.pkl"] = new Config.GenFile {
    `class` = "seed"
    content = read("assets/hk.pkl.tmpl").text.replaceAll("@@HK_VERSION@@", Tools.hkConfigVersion)
  }
}

// BEGIN generated: wave A workflows (tmp/phase-4-generators/workflows-a.ts)

/// The CI/CD security scan of the repository's workflows (Plumber). Only a Critical finding blocks a pull request.
function plumber(): Config.Workflow = new {
  header = #"""
    CI/CD security scan of this repository's GitHub Actions workflows (unpinned
    actions, untrusted shell input, over-broad permissions). Findings surface in the
    Security tab (Code Scanning SARIF).

    Gating model (ported from pantheon-org/tekhne): Critical findings BLOCK the PR;
    everything else is visible in Code Scanning and never blocks. The Plumber action
    runs with soft-fail + continue-on-error so its own A-E score gate and any
    transient runtime error never block; the ONLY blocking signal is a Critical
    finding in the gate step below. Config lives in .plumber.yaml.

    Generated by pantheon-scaffold from pantheon.pkl: change it there, not in this file.
    """#
  name = "Plumber"
  on = new Mapping<String, Any?> {
    ...mainTriggers()
    ["schedule"] = new Listing { new Mapping { ["cron"] = "41 3 * * 1" } }
  }
  permissions = readOnly
  concurrency = concurrencyPerRef
  jobs {
    ["plumber"] {
      name = "Plumber Score"
      `runs-on` = "ubuntu-24.04"
      `timeout-minutes` = 5
      permissions = new Mapping {
        ["contents"] = "read"
        ["security-events"] = "write"
      }
      steps {
        checkout
        new {
          id = "plumber"
          uses = Pins.plumber
          `continue-on-error` = true
          `with` = new Mapping {
            ["soft-fail"] = "true"
            ["score-push"] = "false"
            ["output"] = "results.json"
          }
        }
        new {
          name = "Gate on Critical findings"
          run = #"""
            if [ ! -f results.json ]; then
              echo "::warning::results.json not found; Plumber did not produce a report (likely a transient scan error). Critical gate skipped this run."
              exit 0
            fi
            critical="$(jq '.plumberScore.counts.critical // 0' results.json)"
            if [ "$critical" -gt 0 ]; then
              echo "::error::${critical} Critical-severity Plumber finding(s) present; see the Code Scanning alerts for detail."
              jq -r '(.plumberScore.codeLosses // [])[] | select(.severity == "critical") | "::error::[\(.code)] \(.count) Critical-severity finding(s)"' results.json
              exit 1
            fi
            echo "No Critical-severity Plumber findings. Gate passed."\#n
            """#
        }
      }
    }
  }
}

/// Creates the labels Dependabot applies, from .github/labels.txt.
function syncLabels(): Config.Workflow = new {
  header = #"""
    Creates the labels Dependabot applies (see .github/dependabot.yml). Dependabot
    cannot create labels itself and comments on its PRs when one is missing.
    Edit .github/labels.txt to add a label; this runs on push to main or on demand.
    """#
  name = "Sync Labels"
  on = new Mapping<String, Any?> {
    ["push"] = new Mapping {
      ["branches"] = new Listing { "main" }
      ["paths"] = new Listing { ".github/labels.txt"; ".github/scripts/sync-labels.sh"; ".github/workflows/sync-labels.yml" }
    }
    ["workflow_dispatch"] = new Mapping {}
  }
  permissions = new Mapping {
    ["contents"] = "read"
    ["issues"] = "write"
  }
  jobs {
    ["sync-labels"] {
      name = "Sync Labels"
      `timeout-minutes` = 5
      steps {
        checkout
        new {
          name = "Create or update labels"
          env = new Mapping {
            ["GH_TOKEN"] = "${{ github.token }}"
            ["GH_REPO"] = "${{ github.repository }}"
          }
          run = "bash .github/scripts/sync-labels.sh"
        }
      }
    }
  }
}

/// Rebases open pull request branches that are behind main, under the App token so the required checks run again on the new head.
function prAutoRebase(opts: Config.Options): Config.Workflow = new {
  header = #"""
    The `main` ruleset requires linear history and a strict "branches must be up
    to date" status-check policy, so every push to `main` marks all open PRs as
    BEHIND and blocks them until rebased. This workflow rebases those branches
    onto the latest `main` using the pantheon-ai-bot App token, which (unlike the
    default GITHUB_TOKEN) re-triggers the required checks on the new head.
    Ported from pantheon-org/tekhne.

    Needs the org secret GH_APP_PRIVATE_KEY to be available to this repository and
    the App installed on it with contents and pull-requests write.
    """#
  name = "Auto-rebase PR branches"
  on = new Mapping<String, Any?> {
    ["push"] = new Mapping { ["branches"] = new Listing { "main" } }
    ["workflow_dispatch"] = new Mapping {}
  }
  permissions = readOnly
  concurrency = new Mapping {
    ["group"] = "pr-auto-rebase"
    ["cancel-in-progress"] = true
  }
  jobs {
    ["rebase"] {
      name = "Rebase behind PR branches"
      `timeout-minutes` = 5
      steps {
        mintToken(opts)
        checkoutScripts
        new {
          name = "Rebase behind, non-draft PRs"
          env = new Mapping {
            ["GH_TOKEN"] = "${{ steps.app-token.outputs.token }}"
            ["GH_REPO"] = "${{ github.repository }}"
          }
          run = "bash .github/scripts/auto-rebase.sh"
        }
      }
    }
  }
}

/// Mondays: squash-merges the open release-please pull request, under the App token so the push to main starts release-please.
function releaseAutomerge(opts: Config.Options): Config.Workflow = new {
  header = #"""
    Mondays: squash-merges the open release-please PR so a release lands without a
    human clicking merge. The merge runs under the pantheon-ai-bot App token so the
    push to main fires release-please.yml, which then tags the version.
    Ported from pantheon-org/tekhne. Needs the org secret GH_APP_PRIVATE_KEY.
    """#
  name = "Release Auto-merge"
  on = new Mapping<String, Any?> {
    ["schedule"] = new Listing { new Mapping { ["cron"] = "37 8 * * 1" } }
    ["workflow_dispatch"] = new Mapping {}
  }
  permissions = readOnly
  concurrency = new Mapping {
    ["group"] = "release-automerge"
    ["cancel-in-progress"] = false
  }
  jobs {
    ["automerge"] {
      name = "Merge open release PR"
      `timeout-minutes` = 5
      steps {
        mintToken(opts)
        checkoutScripts
        new {
          name = "Merge open release-please PR"
          env = new Mapping {
            ["GH_TOKEN"] = "${{ steps.app-token.outputs.token }}"
            ["GH_REPO"] = "${{ github.repository }}"
          }
          run = "bash .github/scripts/release-automerge.sh"
        }
      }
    }
  }
}

/// Fails when the commit types copied into the title gate drift from .github/commit-types.txt.
function commitTypes(): Config.Workflow = new {
  header = #"""
    Keeps the PR title gate honest. conventional-commits.yml carries a copy of
    the allowed commit types inside its regex, because it runs on
    pull_request_target and must not read repository files. This runs on an
    ordinary pull_request, where reading them is safe, and fails if:

      - the copy has drifted from .github/commit-types.txt, the canonical list, or
      - the regex no longer accepts or rejects the titles in the script's table,
        including release-please's own pull request titles.

    Path-filtered on purpose. Unlike the title gate and zizmor it is not meant to
    be a required status check: a required check that is skipped blocks the pull
    request forever, so only change this to required after removing the filter.
    Also runs on push to main as a post-merge safety net.
    """#
  name = "Commit Types"
  on = new Mapping<String, Any?> {
    ["pull_request"] = new Mapping {
      ["types"] = new Listing { "opened"; "synchronize"; "reopened" }
      ["branches"] = new Listing { "main" }
      ["paths"] = commitTypesPaths
    }
    ["push"] = new Mapping {
      ["branches"] = new Listing { "main" }
      ["paths"] = commitTypesPaths
    }
  }
  permissions = readOnly
  concurrency = concurrencyPerRef
  jobs {
    ["commit-types"] {
      name = "Commit Types"
      `timeout-minutes` = 5
      steps {
        checkout
        new { name = "Check the gate has not drifted from the canonical list"; run = "bash .github/scripts/check-commit-types.sh" }
      }
    }
  }
}

local commitTypesPaths: Listing<String> = new {
  ".github/commit-types.txt"
  ".github/workflows/conventional-commits.yml"
  ".github/workflows/commit-types.yml"
  ".github/scripts/check-commit-types.sh"
}

/// Checks that the pull request title is a conventional commit. The job name is the required status check, so it must not change.
function conventionalCommits(): Config.Workflow = new {
  header = #"""
    Pull requests are squash-merged, so the title becomes the commit message on
    main and is what release-please parses to pick the version bump and write
    the changelog. A malformed title produces a wrong bump or no release at all,
    silently.

    The allowed types are copied into the regex below from .github/commit-types.txt.
    The copy is deliberate: this runs on pull_request_target, where the workflow
    has a privileged token, so it checks out nothing and reads only the event
    payload. .github/scripts/check-commit-types.sh fails if the copy drifts, and
    the Commit Types workflow runs that check on pull requests.
    """#
  name = "Conventional Commit Title"
  onComment = "zizmor: ignore[dangerous-triggers] reads only the PR title; checks out and runs no PR code"
  on = new Mapping<String, Any?> {
    ["pull_request_target"] = new Mapping {
      ["types"] = new Listing { "opened"; "edited"; "reopened"; "synchronize" }
    }
  }
  permissions = new Mapping {}
  concurrency = new Mapping {
    ["group"] = "${{ github.workflow }}-${{ github.event.pull_request.number }}"
    ["cancel-in-progress"] = true
  }
  jobs {
    ["title"] {
      name = "Conventional Commit Title"
      `timeout-minutes` = 5
      steps {
        new {
          name = "Check the pull request title"
          env = new Mapping { ["PR_TITLE"] = "${{ github.event.pull_request.title }}" }
          run = #"""
            pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([[:alnum:]][[:alnum:]./_-]*\))?!?: [[:lower:]](.*[[:graph:]])?$'
            if [[ ! "$PR_TITLE" =~ $pattern ]]; then
              echo "::error title=Invalid pull request title::The title does not match the required format."
              printf 'Received title: %q\n' "$PR_TITLE"
              echo "Use: <type>[optional scope][optional !]: <summary starting lowercase>"
              echo "Types: build chore ci docs feat fix perf refactor revert style test"
              exit 1
            fi\#n
            """#
        }
      }
    }
  }
}

/// The verbatim config files the wave A workflows use, from pantheon-adr at 1e2fd46.
function workflowFiles(): Mapping<String, Config.GenFile> = new {
  [".plumber.yaml"] = new Config.GenFile { content = read("assets/plumber.yaml").text }
  [".github/labels.txt"] = new Config.GenFile { content = read("assets/labels.txt").text }
  [".github/commit-types.txt"] = new Config.GenFile { content = read("assets/commit-types.txt").text }
  [".github/pull_request_template.md"] = new Config.GenFile { content = read("assets/pull_request_template.md").text }
}

