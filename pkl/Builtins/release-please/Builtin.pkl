/// The release-please builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.ReleasePlease

import "../../Config.pkl"
import "../../Pins.pkl"
import "../Shared.pkl"

/// Keeps one rolling release pull request up to date and tags releases, under the App token so the tag starts the release workflow. With a
/// binary (`options.binary`) it also tags the crate version itself when it has no tag yet (the script tag-release.sh).
function workflow(opts: Config.Options): Config.Workflow =
  let (crate = opts.crateName ?? "crate")
  new {
    header =
      if (opts.binary) #"""
        Keeps one rolling release PR up to date on every push to main (version bump in
        crates/\#(crate)/Cargo.toml and Cargo.lock, plus CHANGELOG.md, from conventional
        commits). Once that PR is merged, the same run tags the new version, and the tag
        starts release.yml (cargo-dist), which builds and publishes the GitHub Release.
        release-please is told not to create the GitHub Release itself, because cargo-dist
        creates it and fails if one exists. Ported from pantheon-org/tekhne.

        Uses the pantheon-ai-bot App token because pushes made with GITHUB_TOKEN do not
        trigger other workflows, so the tag would never start release.yml.
        Needs the org secret GH_APP_PRIVATE_KEY.
        """#
      else #"""
        Keeps one rolling release PR up to date on every push to main (version bump in
        both crates and Cargo.lock, plus CHANGELOG.md, from conventional commits). When
        that PR is merged the same run creates the vX.Y.Z tag and the GitHub Release.
        Consumers pin pahdk-core and pahdk-install by that tag, so the tag is the release.
        There is no cargo-dist here, so release-please may create the GitHub Release.
        Ported from pantheon-org/tekhne.

        Uses the pantheon-ai-bot App token because a tag created with GITHUB_TOKEN does not
        trigger other workflows. Needs the org secret GH_APP_PRIVATE_KEY.
        """#
    name = "Release Please"
    on = new Mapping<String, Any?> {
      ["push"] = new Mapping { ["branches"] = new Listing { "main" } }
      ["workflow_dispatch"] = new Mapping {}
    }
    permissions = Shared.readOnly
    concurrency = new Mapping {
      ["group"] = "release-please"
      ["cancel-in-progress"] = false
    }
    jobs {
      ["release-please"] {
        name = "Update release PR and tag releases"
        `timeout-minutes` = 5
        steps {
          Shared.mintToken(opts)
          new {
            uses = Pins.releasePleaseAction
            `with` = new Mapping {
              ["token"] = "${{ steps.app-token.outputs.token }}"
              ["config-file"] = "release-please-config.json"
              ["manifest-file"] = ".release-please-manifest.json"
            }
          }
          when (opts.binary) {
            bareCheckout("Checkout")
            new {
              name = "Tag the crate version if it has no tag yet"
              env = new Mapping {
                ["GH_TOKEN"] = "${{ steps.app-token.outputs.token }}"
                ["GH_REPO"] = "${{ github.repository }}"
              }
              run = "bash .github/scripts/tag-release.sh"
            }
          }
        }
      }
    }
  }

local function bareCheckout(stepName: String): Config.Step = new {
  name = stepName
  uses = Pins.checkout
  `with` = new Mapping { ["persist-credentials"] = false }
}

/// The release tagging script that `parameterisedFiles()` renders for a repository with a binary: the `release-please` workflow runs it (the step above)
/// to tag the crate version when it has no tag yet. It names the crate.
function parameterisedFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  when (opts.binary) {
    [".github/scripts/tag-release.sh"] = new Config.GenFile {
      template = read("assets/tag-release.sh.j2").text
      context = new Mapping { ["crate"] = Shared.needCrateName(opts) }
      executable = true
    }
  }
}
