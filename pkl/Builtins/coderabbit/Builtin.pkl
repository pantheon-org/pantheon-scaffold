/// The coderabbit builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Coderabbit

import "../../Config.pkl"
import "../Shared.pkl"

/// The files of this builtin that `parameterisedFiles()` renders. The path filter for the bundled skill is in the file only when `skills` is on.
function parameterisedFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  [".coderabbit.yaml"] = new Config.GenFile {
    template = read("assets/coderabbit.yaml.j2").text
    context = new Mapping {
      ["skills"] = opts.skills
      ["skill"] = if (opts.skills) Shared.needSkillName(opts) else ""
    }
  }
}
