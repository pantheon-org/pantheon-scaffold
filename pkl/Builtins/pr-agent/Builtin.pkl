/// The pr-agent builtin: an advisory pull request review by an LLM (`/describe` and `/review`), as a docker step with the providers of
/// `options.prAgentProviders`, and the `.pr_agent.toml` it reads. `Builtins.pkl` re-exports both. Import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.PrAgent

import "../../Config.pkl"
import "../../GenFiles.pkl"
import "../../Workflows.pkl"
import "../../Tools.pkl"
import "../Shared.pkl"

/// The providers once each, by the secret that holds the key: two models of one provider share a key, and the workflow passes it once.
local function bySecret(providers: List<Config.Provider>): List<Config.Provider> =
  providers.distinctBy((p) -> p.secret)

/// The providers once each, by the variable the key is passed in.
local function byEnv(providers: List<Config.Provider>): List<Config.Provider> =
  providers.distinctBy((p) -> p.env)

/// The models after the first, as the JSON list `config.fallback_models` takes. One provider gives `[]`.
local function fallbackModels(models: List<String>): String =
  "[" + models.drop(1).map((m) -> "\"\(m)\"").join(", ") + "]"

/// The advisory review. Skipped for bots, forks, drafts and comments from outside the team, and with no key set it posts a notice and stops.
function workflow(opts: Config.Options): Workflows.Workflow = new {
  local providers = opts.prAgentProviders.toList()
  header = """
    Advisory LLM review of pull requests (/describe and /review). It sends the pull request diff and
    metadata to the LLM providers named below, and posts a description and a review. Advisory only
    (continue-on-error): a provider outage or rate limit never turns this into a failing check, and a
    person makes every decision. The review step runs only when a provider key is set as a repository
    secret; with none it posts a notice and stops. Remove the secrets to turn it off.

    Generated by pantheon-scaffold from scaffold.pkl: change it there, not in this file.
    """
  name = "PR Agent"
  on = new Mapping<String, Any?> {
    ["pull_request"] = new Mapping { ["types"] = new Listing { "opened"; "reopened"; "ready_for_review" } }
    ["issue_comment"] = new Mapping { ["types"] = new Listing { "created" } }
  }
  permissions = new Mapping {
    ["contents"] = "read"
    ["issues"] = "write"
    ["pull-requests"] = "write"
  }
  concurrency = new Mapping {
    ["group"] = "${{ github.workflow }}-${{ github.event.pull_request.number || github.event.issue.number }}"
    ["cancel-in-progress"] = true
  }
  jobs {
    ["pr-agent"] {
      name = "PR Agent"
      // `sender.type != 'Bot'` covers every bot (dependabot, renovate, github-actions). A fork pull request never sees secrets. `!= true` and not
      // `== false` because an issue_comment event has no pull_request.head.repo.fork. A comment only counts on a pull request, from the team.
      `if` = "github.event.sender.type != 'Bot' && github.event.pull_request.head.repo.fork != true && github.event.pull_request.draft != true && (github.event_name != 'issue_comment' || (github.event.issue.pull_request && contains(fromJSON('[\"OWNER\", \"MEMBER\", \"COLLABORATOR\"]'), github.event.comment.author_association)))"
      `timeout-minutes` = 10
      steps {
        new {
          name = "Check for a provider key"
          id = "key"
          env = new Mapping {
            for (p in bySecret(providers)) { [p.secret] = "${{ secrets.\(p.secret) }}" }
          }
          run = """
            present=false
            for name in \(bySecret(providers).map((p) -> p.secret).join(" ")); do
              if [ -n "${!name}" ]; then present=true; fi
            done
            echo "present=$present" >> "$GITHUB_OUTPUT"
            if [ "$present" = false ]; then
              echo "::notice::PR Agent skipped: no provider key is set as a repository secret."
            fi

            """
        }
        // The image is pinned by digest, and the pull request description and review are advisory: a provider outage must not fail the check.
        new {
          name = "PR Agent action step"
          `if` = "steps.key.outputs.present == 'true'"
          `continue-on-error` = true
          uses = Tools.prAgentImage
          env = new Mapping {
            ["GITHUB_TOKEN"] = "${{ secrets.GITHUB_TOKEN }}"
            ["config.model"] = providers.first.model
            ["config.fallback_models"] = fallbackModels(providers.map((p) -> p.model))
            // The fallback models are not in pr-agent's table of context sizes, so without this they fail the moment the primary is unavailable.
            ["config.custom_model_max_tokens"] = "128000"
            for (p in byEnv(providers)) { [p.env] = "${{ secrets.\(p.secret) }}" }
            ["github_action_config.auto_describe"] = "true"
            ["github_action_config.auto_review"] = "true"
            ["github_action_config.auto_improve"] = "false"
          }
        }
      }
    }
  }
}

/// The files of this builtin that `parameterisedFiles()` renders: `.pr_agent.toml`, with the review instructions that `.coderabbit.yaml` carries,
/// and the skill folder in its ignore list only when `skills` is on (audit-skill covers it).
function parameterisedFiles(opts: Config.Options): Mapping<String, GenFiles.GenFile> = new {
  [".pr_agent.toml"] = new GenFiles.GenFile {
    content = """
      # pr-agent settings, read from the default branch. The workflow that runs it is .github/workflows/pr-agent.yml.
      # Generated by pantheon-scaffold from scaffold.pkl: change it there, not in this file.

      [pr_reviewer]
      extra_instructions = \"\"\"
      Every third-party action in .github/workflows must be pinned by commit SHA (or image digest).
      Flag mutable tags, overly broad permissions, and secrets exposed to untrusted triggers.
      In crates/**/*.rs, flag unwrap/expect/panic in non-test code, unchecked indexing, and
      public API changes without matching docs or tests.
      \"\"\"

      [ignore]
      glob = [\(ignoreGlobs(opts))]

      """
  }
}

local function ignoreGlobs(opts: Config.Options): String =
  let (globs = List("target/**", "**/*.lock", "Cargo.lock"))
  (if (opts.skills) List("skills/\(opts.requireSkillName())/**") + globs else globs).map((g) -> "\"\(g)\"").join(", ")
