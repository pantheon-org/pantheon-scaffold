/// The deny builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Deny

import "../../Config.pkl"

/// The verbatim file of this builtin that `baseFiles()` renders.
function baseFiles(): Mapping<String, Config.GenFile> = new {
  ["deny.toml"] = new Config.GenFile { content = read("assets/deny.toml").text }
}
