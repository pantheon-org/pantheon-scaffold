/// The hk builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Hk

import "../../Config.pkl"
import "../../GenFiles.pkl"
import "../../Tools.pkl"
import "../../Presence.pkl"
import "../Shared.pkl"

/// The hook steps the four Rust repositories share (decision 31): `hk.shared.pkl`, owned by the runner, holds the steps, and `hk.pkl` is
/// seeded once, imports it and holds only the hooks. Each repository adds its own steps in `hk.pkl`. `options.features = "all"` is the
/// library repository's `--all-features` in the pre-push clippy and test steps. Checked against real hk in hk.test.ts.
function files(opts: Config.Options): Mapping<String, GenFiles.GenFile> =
  let (p = Presence.forOptions(opts))
  new {
    ["hk.shared.pkl"] = new GenFiles.GenFile {
      template = read("assets/hk.shared.pkl.j2").text
      context = new Mapping {
        ["hkVersion"] = Tools.hkConfigVersion
        ["allFeatures"] = opts.features == "all"
        ["present"] = p.presentFlags
        ["tools"] = p.toolFlags
      }
    }
    ["hk.pkl"] = new GenFiles.GenFile {
      `class` = "seed"
      template = read("assets/hk.pkl.j2").text
      context = new Mapping {
        ["hkVersion"] = Tools.hkConfigVersion
        ["present"] = p.presentFlags
      }
    }
  }
