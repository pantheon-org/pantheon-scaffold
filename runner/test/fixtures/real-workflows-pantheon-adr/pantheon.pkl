amends "../../../../pkl/Config.pkl"

import "../../../../pkl/Builtins.pkl"

// Phase 4 wave D: every workflow builtin, set up like pantheon-adr, rendered by scripts/real-repo-workflows.ts and compared with the real repository.
options {
  toolchain = "1.96.1"
  skillName = "adr-creator"
  crateName = "adr"
  gitDependencyIgnore { "pahdk-core"; "pahdk-install" }
}

workflows {
  ...Builtins.standardWorkflows(options)
}

files {
  ...Builtins.standardFiles(options)
}
