{% if skills %}
# agnix lints the bundled skill against Claude Code's documented formats:
{% else %}
# agnix lints agent skills and config files against Claude Code's documented formats:
{% endif %}
# frontmatter fields and values, allowed-tools names, broken links, leaked
# tool-call markup. Run: agnix -c .agnix.toml .
# CI (.github/workflows/agnix.yml) fails a pull request only on an error it
# introduces. Never run agnix with --fix: its autofixes have changed instruction
# meaning and corrupted files in testing.
# Ported from pantheon-org/tekhne.
target = "{{ target }}"
exclude = [
{% for e in exclude %}
{% if e.comment %}
  # {{ e.comment }}
{% endif %}
  "{{ e.path }}",
{% endfor %}
]

[rules]
# Other agents' rule families: the skill is linted against Claude Code.
codex = false
cursor = false
copilot = false
cline = false
gemini_md = false
kiro_agents = false
kiro_steering = false
amp_checks = false
opencode = false
roo_code = false
windsurf = false
# Portability and wording heuristics: no true positives when graded on these skills.
cross_platform = false
prompt_engineering = false
disabled_rules = [
{% for line in disabledRuleLines %}
  {{ line }}
{% endfor %}
]
