/// The pull-request-template builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.PullRequestTemplate

import "../../Config.pkl"

/// The verbatim file of this builtin that `workflowFiles()` renders.
function workflowFiles(): Mapping<String, Config.GenFile> = new {
  [".github/pull_request_template.md"] = new Config.GenFile { content = read("assets/pull_request_template.md").text }
}
