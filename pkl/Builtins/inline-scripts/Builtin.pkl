/// The inline-scripts builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.InlineScripts

import "../../Config.pkl"
import "../Shared.pkl"

/// A run block in a workflow or composite action may hold at most 15 lines of code.
function workflow(): Config.Workflow = new {
  header = """
    Rule: a `run:` block in a workflow or composite action may hold at most 15 lines
    of code (blank and comment lines excluded). Longer logic belongs in a script under
    .github/scripts/, where it can be run locally, shellchecked and tested; the step
    then calls it. Values reach the script through `env:`, never by pasting `${{ }}`
    into its text. A block that must stay long can opt out with a line
    `# inline-ok: <reason>` inside it. Ported from pantheon-org/tekhne.

    No path filter, so the check always reports a conclusion; also runs on push to
    main as a post-merge safety net. Deterministic and offline.
    """
  name = "Inline Scripts"
  on = Shared.mainTriggers()
  permissions = Shared.readOnly
  concurrency = Shared.concurrencyPerRef
  jobs {
    ["inline-scripts"] {
      name = "Inline Scripts"
      `timeout-minutes` = 5
      steps {
        Shared.checkout
        new { name = "Check run blocks are short"; run = "bash .github/scripts/check-inline-scripts.sh" }
      }
    }
  }
}

/// The verbatim file of this builtin that `baseFiles()` renders.
function baseFiles(): Mapping<String, Config.GenFile> = new {
  [".github/scripts/check-inline-scripts.sh"] = new Config.GenFile { content = read("assets/check-inline-scripts.sh").text; executable = true }
}
