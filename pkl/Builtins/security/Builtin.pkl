/// The security builtin. `Builtins.pkl` re-exports it; import `Builtins.pkl`, not this file.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.builtins.Security

import "../../Config.pkl"
import "../Shared.pkl"

/// The files of this builtin that `parameterisedFiles()` renders.
function parameterisedFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  ["SECURITY.md"] = new Config.GenFile {
    `class` = "seed"
    template = if (opts.binary) read("assets/security-binary.md.j2").text else null
    content = if (opts.binary) null else read("assets/security-library.md").text
    context = if (opts.binary)
      new Mapping {
        ["crate"] = Shared.needCrateName(opts)
        ["skills"] = opts.skills
        ["skill"] = if (opts.skills) Shared.needSkillName(opts) else ""
      }
    else null
  }
}
