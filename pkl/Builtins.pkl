/// Reusable builtin workflows and files. A repository's pantheon.pkl calls these with its options,
/// and may override anything in the result. Pins live in Pins.pkl.
///
/// This module is the API and holds no builtin of its own. Each builtin lives in `Builtins/<name>/Builtin.pkl` with the assets it reads in
/// `Builtins/<name>/assets/`; the functions below call into those modules, and the aggregators (`baseFiles`, `toolingFiles`, `workflowFiles`,
/// `analysisFiles`, `verbatimFiles`, `parameterisedFiles`, `standardWorkflows`, `standardFiles`) spread each folder's slice in a fixed order.
/// `Builtins/Shared.pkl` holds the steps several builtins use and is internal.
@ModuleInfo { minPklVersion = "0.32.0" }
module pantheon.scaffold.Builtins

import "Config.pkl"
import "Builtins/Shared.pkl"
import "Builtins/rust-toolchain/Builtin.pkl" as rustToolchainBuiltin
import "Builtins/actionlint/Builtin.pkl" as actionlintBuiltin
import "Builtins/coderabbit/Builtin.pkl" as coderabbitBuiltin
import "Builtins/security/Builtin.pkl" as securityBuiltin
import "Builtins/hk/Builtin.pkl" as hkBuiltin
import "Builtins/mise/Builtin.pkl" as miseBuiltin
import "Builtins/gitignore/Builtin.pkl" as gitignoreBuiltin
import "Builtins/pull-request-template/Builtin.pkl" as pullRequestTemplateBuiltin
import "Builtins/claude-settings/Builtin.pkl" as claudeSettingsBuiltin
import "Builtins/rumdl/Builtin.pkl" as rumdlBuiltin
import "Builtins/agnix/Builtin.pkl" as agnixBuiltin
import "Builtins/dependabot/Builtin.pkl" as dependabotBuiltin
import "Builtins/upgrade/Builtin.pkl" as upgradeBuiltin
import "Builtins/release/Builtin.pkl" as releaseBuiltin
import "Builtins/scaffold-check/Builtin.pkl" as scaffoldCheckBuiltin
import "Builtins/audit-skill/Builtin.pkl" as auditSkillBuiltin
import "Builtins/aislop/Builtin.pkl" as aislopBuiltin
import "Builtins/zizmor/Builtin.pkl" as zizmorBuiltin
import "Builtins/release-please/Builtin.pkl" as releasePleaseBuiltin
import "Builtins/commit-types/Builtin.pkl" as commitTypesBuiltin
import "Builtins/conventional-commits/Builtin.pkl" as conventionalCommitsBuiltin
import "Builtins/release-automerge/Builtin.pkl" as releaseAutomergeBuiltin
import "Builtins/pr-auto-rebase/Builtin.pkl" as prAutoRebaseBuiltin
import "Builtins/sync-labels/Builtin.pkl" as syncLabelsBuiltin
import "Builtins/inline-scripts/Builtin.pkl" as inlineScriptsBuiltin
import "Builtins/rust-ci/Builtin.pkl" as rustCiBuiltin
import "Builtins/cargo-deny/Builtin.pkl" as cargoDenyBuiltin
import "Builtins/plumber/Builtin.pkl" as plumberBuiltin

/// Checks the dependency tree against deny.toml.
function cargoDeny(opts: Config.Options): Config.Workflow = cargoDenyBuiltin.workflow(opts)

/// Format, lint, build and test the Rust workspace. With `features = "all"` (the library repository) clippy, the build and the tests run with
/// `--all-features`, and an extra step builds with the default features.
function rustCi(opts: Config.Options): Config.Workflow = rustCiBuiltin.workflow(opts)

/// A run block in a workflow or composite action may hold at most 15 lines of code.
function inlineScripts(): Config.Workflow = inlineScriptsBuiltin.workflow()

/// The verbatim files the three builtins depend on.
function baseFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  let (p = Shared.present(opts))
  new {
    when (p.has("rust-toolchain")) { ...rustToolchainBuiltin.baseFiles(opts) }
    when (p.has("cargo-deny")) { ...cargoDenyBuiltin.baseFiles() }
    when (p.has("inline-scripts")) { ...inlineScriptsBuiltin.baseFiles() }
    when (p.has("rust-ci")) { ...rustCiBuiltin.baseFiles() }
  }

/// The tooling files the four Rust repositories share, all verbatim: the seven shared scripts that `baseFiles` does not cover (with
/// `cargo-deny.sh` and `check-inline-scripts.sh` from there they are the nine shared scripts), the rumdl configuration and the Claude Code
/// settings. All nine scripts are executable. `sync-labels.sh` is not executable in the four repositories today, and its workflow runs
/// it with `bash`, so the bit never mattered. It is rendered executable like the other eight.
function toolingFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  let (p = Shared.present(opts))
  new {
    when (p.has("agnix")) { ...agnixBuiltin.toolingFiles() }
    when (p.has("pr-auto-rebase")) { ...prAutoRebaseBuiltin.toolingFiles() }
    when (p.has("commit-types")) { ...commitTypesBuiltin.toolingFiles() }
    when (p.has("release-automerge")) { ...releaseAutomergeBuiltin.toolingFiles() }
    when (p.has("sync-labels")) { ...syncLabelsBuiltin.toolingFiles() }
    when (p.has("rumdl")) { ...rumdlBuiltin.toolingFiles() }
    when (p.has("claude-settings")) { ...claudeSettingsBuiltin.toolingFiles() }
  }

/// mise.toml, owned by the runner, and the files around it: mise.lock (written by mise, so external) and a per-repository mise config,
/// seeded once. mise reads both config files, the second adds tools, and for a tool listed in both mise.toml wins (decision 29, checked
/// against real mise in mise.test.ts). The tool pins come from Tools.pkl and the runner pin from the package version.
function miseFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  if (Shared.present(opts).has("mise")) miseBuiltin.files(opts) else new Mapping {}

/// The hook steps the four Rust repositories share (decision 31): `hk.shared.pkl`, owned by the runner, holds the steps, and `hk.pkl` is
/// seeded once, imports it and holds only the hooks. Each repository adds its own steps in `hk.pkl`. `options.features = "all"` is the
/// library repository's `--all-features` in the pre-push clippy and test steps. Checked against real hk in hk.test.ts.
function hkFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  if (Shared.present(opts).has("hk")) hkBuiltin.files(opts) else new Mapping {}

/// The CI/CD security scan of the repository's workflows (Plumber). Only a Critical finding blocks a pull request.
function plumber(): Config.Workflow = plumberBuiltin.workflow()

/// Creates the labels Dependabot applies, from .github/labels.txt.
function syncLabels(): Config.Workflow = syncLabelsBuiltin.workflow()

/// Rebases open pull request branches that are behind main, under the App token so the required checks run again on the new head.
function prAutoRebase(opts: Config.Options): Config.Workflow = prAutoRebaseBuiltin.workflow(opts)

/// Mondays: squash-merges the open release-please pull request, under the App token so the push to main starts release-please.
function releaseAutomerge(opts: Config.Options): Config.Workflow = releaseAutomergeBuiltin.workflow(opts)

/// Fails when the commit types copied into the title gate drift from .github/commit-types.txt.
function commitTypes(): Config.Workflow = commitTypesBuiltin.workflow()

/// Checks that the pull request title is a conventional commit. The job name is the required status check, so it must not change.
function conventionalCommits(): Config.Workflow = conventionalCommitsBuiltin.workflow()

/// The verbatim config files the wave A workflows use, from pantheon-adr at 1e2fd46.
function workflowFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  let (p = Shared.present(opts))
  new {
    when (p.has("plumber")) { ...plumberBuiltin.workflowFiles() }
    when (p.has("sync-labels")) { ...syncLabelsBuiltin.workflowFiles() }
    when (p.has("commit-types")) { ...commitTypesBuiltin.workflowFiles() }
    when (p.has("pull-request-template")) { ...pullRequestTemplateBuiltin.workflowFiles() }
  }

/// Keeps one rolling release pull request up to date and tags releases, under the App token so the tag starts the release workflow. With a
/// binary (`options.binary`) it also tags the crate version itself when it has no tag yet (the script tag-release.sh).
function releasePlease(opts: Config.Options): Config.Workflow = releasePleaseBuiltin.workflow(opts)

/// The zizmor security scan of the workflows. It reads .github/zizmor.yml when the repository has a binary (the config silences findings in the
/// cargo-dist generated release.yml), and also scans action.yml when the repository has its own composite action.
function zizmor(opts: Config.Options): Config.Workflow = zizmorBuiltin.workflow(opts)

/// Lints the skill (or the agent files) with agnix. The pinned release is downloaded from its public URL and checked against a pinned SHA-256.
/// A pull request fails only on an error it introduces.
function agnix(opts: Config.Options): Config.Workflow = agnixBuiltin.workflow(opts)

/// The code-quality gate (aislop), scored out of 100. aislop's version is pinned in Tools.pkl, because Dependabot does not read an inline npx
/// version.
function aislop(): Config.Workflow = aislopBuiltin.workflow()

/// The github-actions entry excludes every workflow file the package renders (`exclude-paths`): the runner owns them, so a Dependabot bump of a
/// pin in one is drift, and `check` exits 4. Their pins move through Pins.pkl and `upgrade`. Workflows the repository writes itself are still updated.
function dependabot(opts: Config.Options): Config.GenFile = dependabotBuiltin.file(opts, standardWorkflows(opts).keys.toList())

/// The config files that go with the wave B builtins: .agnix.toml (the first line depends on whether the repository has a skill), dependabot.yml,
/// and, for a repository with a binary, .github/zizmor.yml (the variant with the extra entry for action.yml when there is a composite action).
function analysisFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  let (p = Shared.present(opts))
  new {
    when (p.has("agnix")) { ...agnixBuiltin.analysisFiles(opts) }
    when (p.has("dependabot")) { [".github/dependabot.yml"] = dependabot(opts) }
    when (p.has("zizmor")) { ...zizmorBuiltin.analysisFiles(opts) }
  }

/// The consumer upgrade workflow: weekly, checks the freshness record, finds the latest release the known-bad list allows, upgrades, and
/// opens a pull request under the App token. Removed by `detach`, since it would fail on every run once the repository leaves the scaffold.
/// The App steps are unverified: pushing a change to workflow files needs `workflows: write` on the App, which is not confirmed (plan P.4).
function upgradeWorkflow(opts: Config.Options): Config.Workflow = upgradeBuiltin.workflow(opts)

/// The verbatim files of the `binary` toggle, and `.gitignore` for every repository. `.gitignore` is `target/` (decision 74), the form three
/// repositories use. `release.yml` is generated by `dist generate`, so it is listed as external: the runner never writes or hashes it, and
/// the drift check of wave D compares it with what `dist generate` would write.
function verbatimFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  let (p = Shared.present(opts))
  new {
    when (p.has("gitignore")) { ...gitignoreBuiltin.verbatimFiles() }
    when (opts.binary) {
      when (p.has("actionlint")) { ...actionlintBuiltin.verbatimFiles() }
      when (p.has("release")) { ...releaseBuiltin.verbatimFiles() }
    }
  }

/// Validates and grades the bundled skill (`skills` toggle, option `skillName`). With `compositeAction` the repository is the skill auditor
/// itself, so it runs its own action with a bootstrap binary instead of the released action.
function auditSkill(opts: Config.Options): Config.Workflow = auditSkillBuiltin.workflow(opts)

/// The files of the parameterised group: `.coderabbit.yaml` always (the skill line only with `skills`), `SECURITY.md` seeded once (the binary
/// text with the crate and skill names, or the library text), and with `binary` the release tagging script.
function parameterisedFiles(opts: Config.Options): Mapping<String, Config.GenFile> =
  let (p = Shared.present(opts))
  new {
    when (p.has("coderabbit")) { ...coderabbitBuiltin.parameterisedFiles(opts) }
    when (p.has("security")) { ...securityBuiltin.parameterisedFiles(opts) }
    when (p.has("release-please")) { ...releasePleaseBuiltin.parameterisedFiles(opts) }
  }

/// Every workflow of the workflow layer for a repository with these options: the thirteen that every repository has, and `audit-skill` when
/// `skills` is on. Turning `skills` off drops the entry, so the runner deletes the file it rendered before.
function standardWorkflows(opts: Config.Options): Mapping<String, Config.Workflow> =
  let (p = Shared.present(opts))
  new {
    when (p.has("plumber")) { ["plumber"] = plumber() }
    when (p.has("sync-labels")) { ["sync-labels"] = syncLabels() }
    when (p.has("pr-auto-rebase")) { ["pr-auto-rebase"] = prAutoRebase(opts) }
    when (p.has("release-automerge")) { ["release-automerge"] = releaseAutomerge(opts) }
    when (p.has("commit-types")) { ["commit-types"] = commitTypes() }
    when (p.has("conventional-commits")) { ["conventional-commits"] = conventionalCommits() }
    when (p.has("release-please")) { ["release-please"] = releasePlease(opts) }
    when (p.has("zizmor")) { ["zizmor"] = zizmor(opts) }
    when (p.has("agnix")) { ["agnix"] = agnix(opts) }
    when (p.has("aislop")) { ["aislop"] = aislop() }
    when (p.has("rust-ci")) { ["rust-ci"] = rustCi(opts) }
    when (p.has("cargo-deny")) { ["cargo-deny"] = cargoDeny(opts) }
    when (p.has("inline-scripts")) { ["inline-scripts"] = inlineScripts() }
    when (opts.skills && p.has("audit-skill")) { ["audit-skill"] = auditSkill(opts) }
    when (p.has("scaffold-check")) { ["scaffold-check"] = scaffoldCheck() }
    when (opts.binary && p.has("release")) { ["dist-check"] = distCheck() }
  }

/// Every file of the workflow layer for a repository with these options: the config files the workflows read, the verbatim files and the
/// parameterised ones. Files that belong to `binary` are dropped when it is off.
function standardFiles(opts: Config.Options): Mapping<String, Config.GenFile> = new {
  ...workflowFiles(opts)
  ...analysisFiles(opts)
  ...verbatimFiles(opts)
  ...parameterisedFiles(opts)
}

/// The drift check of the generated release.yml (`binary`). `dist generate --check` fails when release.yml is not what cargo-dist would write
/// from dist-workspace.toml, which catches a hand edit and a Dependabot bump of an action inside the generated file (decision 85).
function distCheck(): Config.Workflow = releaseBuiltin.workflow()

/// `check` in consumer CI (every repository): the sample job of docs/check-in-ci.md. It evaluates a pantheon.pkl, so it runs on
/// `pull_request` only, with no secrets, and reads the tools from the lock file.
function scaffoldCheck(): Config.Workflow = scaffoldCheckBuiltin.workflow()
