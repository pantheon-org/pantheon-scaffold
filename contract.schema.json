{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pantheon-org/pantheon-scaffold/contract.schema.json",
  "title": "pantheon-scaffold contract",
  "description": "The one JSON document the pkl package renders and the runner reads (decision 44 of the plan).",
  "type": "object",
  "required": ["schemaVersion", "files", "pins", "escapeHatch"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "class", "mode"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "class": { "enum": ["owned", "seed", "external"] },
          "mode": { "enum": ["0644", "0755"] },
          "content": { "type": "string" },
          "template": { "type": "string" },
          "context": { "type": "object" },
          "removeOnDetach": { "type": "boolean" }
        }
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "sha", "version"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packageUri": { "type": "string", "minLength": 1 },
    "requires": {
      "type": "object",
      "required": ["runner"],
      "additionalProperties": false,
      "properties": { "runner": { "type": "string", "minLength": 1 } }
    },
    "securityBuiltins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "enabled"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "presets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^presets/([A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.pkl$" }
    },
    "escapeHatch": {
      "type": "object",
      "required": ["uses", "constructs"],
      "additionalProperties": false,
      "properties": {
        "uses": { "type": "integer", "minimum": 0 },
        "constructs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
